---
import { renderInline } from '@/lib/md';

// A fill-in table.
// mode "prompt": the table as printed. Any cell containing ______ is a blank to fill in.
// mode "answer": the completed table; cells that were blank in the prompt are highlighted.
// `rows` is the printed table (blanks included); `answer` is the same grid fully filled in.
// A cell is a string, or { text, rowspan?, colspan? } for a merged cell. A row lists only the cells it
// starts (as in HTML), so a row under a rowspan cell has one cell fewer.
// `answerHead` (optional): adds an extra answer-only column. In the answer grid each row then carries one
// extra last cell, e.g. a sentence the student writes after reading the row.
type Cell = string | { text: string; rowspan?: number; colspan?: number };
interface Props {
  mode: 'prompt' | 'answer';
  columns: string[];
  rows: Cell[][];
  answer?: Cell[][];
  answerHead?: string;
}
const { mode, columns, rows, answer = [], answerHead } = Astro.props;

const txt = (c: unknown) => (c && typeof c === 'object' ? String((c as any).text ?? '') : String(c ?? ''));
const span = (c: unknown, k: 'rowspan' | 'colspan') => (c && typeof c === 'object' ? (c as any)[k] : undefined);
const isBlank = (c: unknown) => /_{3,}/.test(txt(c));
const useAnswer = mode === 'answer' && answer.length > 0;
const shown = useAnswer ? answer : rows;
const extra = useAnswer && !!answerHead;
---

<div class="tbl-wrap">
  <table class="tbl">
    <thead>
      <tr>
        {columns.map((c) => <th set:html={renderInline(c)} />)}
        {extra && <th>{answerHead}</th>}
      </tr>
    </thead>
    <tbody>
      {shown.map((row, i) => (
        <tr>
          {row.map((cell, j) => {
            const isExtra = extra && j === row.length - 1;
            const printed = rows[i]?.[j];
            const filled = mode === 'answer' && (isExtra || isBlank(printed));
            return (
              <td
                class={filled ? 'fill' : undefined}
                rowspan={span(cell, 'rowspan')}
                colspan={span(cell, 'colspan')}
                set:html={renderInline(txt(cell))}
              />
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .tbl-wrap { max-width: 68ch; margin: 4px 0 16px; overflow-x: auto; }
  .tbl { border-collapse: collapse; width: 100%; font-family: var(--font-ui); font-size: 14px; line-height: 1.5; }
  .tbl th, .tbl td { border: 1px solid var(--border); padding: 6px 12px; text-align: left; vertical-align: top; }
  .tbl th { background: var(--surface); color: var(--ink-muted); font-weight: 600; font-size: 12px; }
  .tbl td.fill { background: var(--green-light); color: var(--green); font-weight: 500; }
  .tbl td :global(.blank) { display: inline-block; min-width: 4ch; border-bottom: 1.5px solid var(--ink-muted); margin: 0 2px; transform: translateY(2px); }
  @media (max-width: 480px) { .tbl th, .tbl td { padding: 5px 8px; font-size: 13px; } }
</style>