---
interface Props { data: any }
const { data } = Astro.props;
const embed: string | undefined = data?.meta?.embed;
const description: string | undefined = data?.meta?.description;
---

{embed ? (
  <div class="an-frame">
    <iframe src={embed} title={data?.meta?.title ?? 'Animation'} loading="lazy" allowfullscreen></iframe>
  </div>
) : (
  <div class="an-soon">
    <p class="an-soon-title">Animation coming soon</p>
    {description && <p class="an-soon-text">{description}</p>}
  </div>
)}

<style>
  .an-frame { position: relative; aspect-ratio: 16 / 9; max-width: 960px; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; background: var(--surface); }
  .an-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .an-soon { padding: 40px 24px; border: 1px dashed var(--border); border-radius: 12px; background: var(--surface); text-align: center; font-family: var(--font-ui); max-width: 68ch; }
  .an-soon-title { font-size: 16px; font-weight: 600; color: var(--ink); }
  .an-soon-text { margin-top: 6px; font-size: 14px; color: var(--ink-muted); }
</style>