---
interface Chapter { title: string; abs: number; pos?: number; href: string }
interface Unit { slug: string; label: string | null; chapters: Chapter[] }
interface PageLink { label: string; href: string; active?: boolean }

interface Props {
  bookTitle: string;
  bookSlug: string;
  bookSub: string;
  classNum: string;
  subject: string;
  units: Unit[];
  mode: 'unit' | 'chapter';
  activeUnit?: string;
  activeChapter?: string;
  pageLinks?: PageLink[];
  bookLinks?: PageLink[];
}

const { bookTitle, bookSlug, bookSub, classNum, subject, units, mode, activeUnit, activeChapter, pageLinks = [], bookLinks = [] } = Astro.props;
const base = `/ncert/class-${classNum}/subject:${subject}/${bookSlug}`;
// Folder name is the key: chapter-1-1, chapter-a-1, chapter-8.
const keyOf = (c: Chapter) => c.href.split('/').pop()!;
const codeOf = (c: Chapter) => keyOf(c).replace('chapter-', '').toUpperCase();
---

<aside class="sidebar">
  <div class="sidebar-book">
    <div class="sidebar-book-label">Class {classNum} · {subject}</div>
    <div class="sidebar-book-title">{bookTitle}</div>
    <div class="sidebar-book-sub">{bookSub}</div>
  </div>

  {bookLinks.length > 0 && (
    <div class="sidebar-book-links">
      {bookLinks.map((l) => (
        <a href={l.href} class={l.active ? 'active-page' : ''}>{l.label}</a>
      ))}
    </div>
  )}

  {units.map((u) => (
    <div class="sidebar-unit">
      {u.label && (
        <div class="sidebar-unit-label">
          {mode === 'unit' && u.slug ? (
            <a href={`${base}/${u.slug}`} class={activeUnit === u.slug ? 'active-unit' : ''}>{u.label}</a>
          ) : (
            u.label
          )}
        </div>
      )}
      <div class="sidebar-ch">
        {u.chapters.map((c) => (
          <>
            <a href={c.href} class={activeChapter === keyOf(c) ? 'active' : ''}>
              Ch {codeOf(c)} · {c.title}
            </a>
            {activeChapter === keyOf(c) && pageLinks.length > 0 && (
              <div class="sidebar-page-links">
                {pageLinks.map((l) => (
                  <a href={l.href} class={l.active ? 'active-page' : ''}>{l.label}</a>
                ))}
              </div>
            )}
          </>
        ))}
      </div>
    </div>
  ))}
</aside>

<style>
  .sidebar {
    position: sticky; top: 52px; height: calc(100vh - 52px); overflow-y: auto;
    border-right: 1px solid var(--border); background: var(--bg);
    padding: 20px 0; width: 260px; flex-shrink: 0;
  }
  .sidebar-book { padding: 0 16px 16px; border-bottom: 1px solid var(--border); margin-bottom: 8px; }
  .sidebar-book-label { font-family: var(--font-ui); font-size: 11px; color: var(--ink-faint); margin-bottom: 4px; }
  .sidebar-book-title { font-family: var(--font-ui); font-size: 13px; font-weight: 600; color: var(--ink); }
  .sidebar-book-sub { font-family: var(--font-ui); font-size: 12px; color: var(--ink-muted); }
  .sidebar-book-links { padding: 4px 16px 8px; display: flex; flex-direction: column; gap: 1px; border-bottom: 1px solid var(--border); margin-bottom: 8px; }
  .sidebar-book-links a {
    font-family: var(--font-ui); font-size: 12px; color: var(--ink-muted);
    text-decoration: none; padding: 3px 8px; border-radius: 4px;
  }
  .sidebar-book-links a:hover { background: var(--surface); color: var(--ink); }
  .sidebar-book-links a.active-page { color: var(--saffron); background: var(--saffron-light); font-weight: 500; }
  .sidebar-unit { margin-bottom: 4px; }
  .sidebar-unit-label {
    font-family: var(--font-ui); font-size: 11px; font-weight: 600;
    color: var(--ink-faint); text-transform: uppercase; letter-spacing: .06em;
    padding: 8px 16px 4px;
  }
  .sidebar-unit-label a { color: inherit; text-decoration: none; }
  .sidebar-unit-label a.active-unit { color: var(--saffron); }
  .sidebar-ch { display: flex; flex-direction: column; }
  .sidebar-ch > a {
    font-family: var(--font-ui); font-size: 13px; color: var(--ink-muted);
    text-decoration: none; padding: 5px 16px; border-left: 2px solid transparent;
    transition: all .15s;
  }
  .sidebar-ch > a:hover { color: var(--ink); background: var(--surface); }
  .sidebar-ch > a.active {
    color: var(--ink); font-weight: 500;
    border-left-color: var(--saffron); background: var(--saffron-light);
  }
  .sidebar-page-links { padding: 2px 16px 4px 28px; display: flex; flex-direction: column; gap: 1px; }
  .sidebar-page-links a {
    font-family: var(--font-ui); font-size: 12px; color: var(--ink-muted);
    text-decoration: none; padding: 3px 8px; border-radius: 4px;
  }
  .sidebar-page-links a:hover { background: var(--surface); color: var(--ink); }
  .sidebar-page-links a.active-page { color: var(--saffron); background: var(--saffron-light); font-weight: 500; }

  @media (max-width: 768px) { .sidebar { display: none; } }
</style>