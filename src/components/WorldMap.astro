// ---------- pointer ----------
const ptrs = new Map(); let moved = false, start = null, pinch = 0;
svg.addEventListener('pointerdown', (e) => {
  svg.setPointerCapture(e.pointerId); ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
  if (ptrs.size === 1) { moved = false; start = { x: e.clientX, y: e.clientY, cx: view.cx, cy: view.cy }; }
  if (ptrs.size === 2) { const [a, b] = [...ptrs.values()]; pinch = Math.hypot(a.x - b.x, a.y - b.y); moved = true; }
});
svg.addEventListener('pointermove', (e) => {
  const lon = wl(x2lon(toSvg(e).x)), lat = y2lat(toSvg(e).y);
  if (world) $('wm-status').textContent = `${lat.toFixed(2)}°, ${lon.toFixed(2)}°`;
  if (ptrs.has(e.pointerId)) {
    ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (ptrs.size === 2) {
      const [a, b] = [...ptrs.values()], d = Math.hypot(a.x - b.x, a.y - b.y);
      if (pinch) zoomAt(pinch / d, { clientX: (a.x + b.x) / 2, clientY: (a.y + b.y) / 2 }); pinch = d; return;
    }
    if (start && (moved || Math.hypot(e.clientX - start.x, e.clientY - start.y) > 5)) {
      moved = true; view.cx = start.cx - (e.clientX - start.x) / scale; view.cy = start.cy - (e.clientY - start.y) / scale; apply(); tip.hidden = true; return;
    }
  }
  const el = e.target.closest?.('[data-k]');
  const html = el ? infoFor(el) : '';
  if (html && !ptrs.size) {
    tip.innerHTML = html; tip.hidden = false;
    const r = stage.getBoundingClientRect(), tw = tip.offsetWidth, th = tip.offsetHeight;
    tip.style.left = Math.min(e.clientX - r.left + 14, r.width - tw - 8) + 'px';
    tip.style.top = Math.min(e.clientY - r.top + 14, r.height - th - 8) + 'px';
  } else tip.hidden = true;
});
svg.addEventListener('pointerleave', () => { tip.hidden = true; });
svg.addEventListener('pointerup', (e) => {
