    let q = p;
    if (land && !onLand(p[0], p[1])) q = nearest(p, 4) || p; else { const n = nearest(p, 0.12); if (n) q = n; }
    const l = out[out.length - 1]; if (!l || l[0] !== q[0] || l[1] !== q[1]) out.push(q);
  }
  return out.length >= 3 ? out : coords;
}

// ----- official regions -----
const ringCache = new Map();
const R = (id, d) => { if (!ringCache.has(id)) ringCache.set(id, allRings(d)); return ringCache.get(id); };
function resolve(r) {
  const n = norm(r.name), par = norm(String(r.parent || '').split(',')[0]), type = String(r.type || '');
  const T = {
    india_district: () => { const l = loaded.d?.districts || []; const x = l.find((d) => norm(d.n) === n && (!par || norm(d.s) === par)) || l.find((d) => norm(d.n) === n); return x && { id: 'd' + x.code + x.n, label: x.n + ', ' + x.s, d: x.d }; },
    india_state: () => { const x = world.india.find((s) => norm(s.n) === n); return x && { id: 's' + x.n, label: x.n, d: x.d }; },
    world_state: () => { const bc = loaded.f?.byCountry || {}; for (const cc in bc) { const c = world.countries.find((k) => k.id === cc); const s = bc[cc].find((s) => norm(s.n) === n && (!par || !c || norm(c.n) === par || norm(c.f) === par)); if (s) return { id: 'f' + cc + s.n, label: s.n + (c ? ', ' + c.n : ''), d: s.d }; } },
    country: () => { const c = world.countries.find((k) => norm(k.n) === n || norm(k.f) === n); return c && { id: 'c' + c.id, label: c.n, d: c.d }; },
  };
  const order = [...new Set([type, ...(type.startsWith('india') ? ['india_state', 'india_district'] : ['world_state', 'country'])])];
  for (const t of order) { const h = T[t]?.(); if (h) return { ...h, rings: R(h.id, h.d) }; }
  return null;
}

// ----- match score and picture for the visual check -----
function iou(A, B) {
  const b = bboxRings([...A, ...B]), dx = b[2] - b[0] || 1, dy = b[3] - b[1] || 1, w = 700, h = Math.max(50, Math.min(900, Math.round((w * dy) / dx)));
  const px = (rs) => { const c = document.createElement('canvas'); c.width = w; c.height = h; const x = c.getContext('2d'); x.setTransform(w / dx, 0, 0, h / dy, (-b[0] * w) / dx, (-b[1] * h) / dy); x.fill(new Path2D(dOf(rs))); return x.getImageData(0, 0, w, h).data; };
  const a = px(A), c = px(B); let i = 0, u = 0;
  for (let k = 3; k < a.length; k += 4) { const p = a[k] > 127, q = c[k] > 127; if (p && q) i++; if (p || q) u++; }
  return u ? i / u : 0;
}
function snapshot(A, B, used) {
  let b = bboxRings([...A, ...(B || [])]); const pw = (b[2] - b[0]) * 0.08, ph = (b[3] - b[1]) * 0.08; b = [b[0] - pw, b[1] - ph, b[2] + pw, b[3] + ph];
  const dx = b[2] - b[0], dy = b[3] - b[1], s = Math.min(900 / dx, 1000 / dy);
  const c = document.createElement('canvas'); c.width = Math.round(dx * s); c.height = Math.round(dy * s);
  const x = c.getContext('2d'); x.fillStyle = '#fff'; x.fillRect(0, 0, c.width, c.height); x.setTransform(s, 0, 0, s, -b[0] * s, -b[1] * s); x.lineJoin = 'round';
  const hit = (q) => q[2] >= b[0] && q[0] <= b[2] && q[3] >= b[1] && q[1] <= b[3];
  for (const k of world.countries) { if (!hit(k.b)) continue; const p = new Path2D(k.d); x.fillStyle = '#f1efe8'; x.fill(p); x.strokeStyle = '#8a8a8a'; x.lineWidth = 1 / s; x.stroke(p); }
  for (const st of world.india) { x.strokeStyle = '#b5b5b5'; x.lineWidth = 0.7 / s; x.stroke(new Path2D(st.d)); }
  if (B) { const p = new Path2D(dOf(B)); x.fillStyle = 'rgba(0,90,220,.22)'; x.fill(p); x.strokeStyle = '#0a4fd6'; x.lineWidth = 2.5 / s; x.stroke(p); }
  x.fillStyle = 'rgba(220,0,0,.42)'; x.fill(new Path2D(dOf(A)));
  x.textAlign = 'center'; x.font = `${11 / s}px sans-serif`;
  x.fillStyle = '#222'; for (const k of world.countries) if (k.r > 14 && hit(k.b)) x.fillText(k.n, k.c[0], k.c[1]);
  x.fillStyle = '#555'; for (const st of world.india) if (st.r > 6) x.fillText(st.n, st.c[0], st.c[1]);
  x.fillStyle = '#900'; x.font = `bold ${11 / s}px sans-serif`;
  for (const u of used) { const q = bboxRings(u.rings); x.fillText(u.label.split(',')[0], (q[0] + q[2]) / 2, (q[1] + q[3]) / 2); }
  return c.toDataURL('image/png').split(',')[1];
}

// ----- reference polygons from the historical-basemaps repo -----
async function repoRef(year, polity) {
  if (!repoRef.list) {
    const r = await fetch('https://api.github.com/repos/aourednik/historical-basemaps/contents/geojson');
    if (!r.ok) throw new Error('GitHub ' + r.status);
    repoRef.list = (await r.json()).map((f) => { const m = /^world_(bc)?(\d+)\.geojson$/.exec(f.name); return m && { y: (m[1] ? -1 : 1) * +m[2], url: f.download_url }; }).filter(Boolean);
  }
  if (!repoRef.list.length) throw new Error('repo layout changed');
  const f = repoRef.list.reduce((a, b) => (Math.abs(b.y - year) < Math.abs(a.y - year) ? b : a));
  step(`Fetching repo snapshot nearest to ${yl(year)}: ${yl(f.y)}`);
  repoRef.files ??= {}; repoRef.files[f.url] ??= await (await fetch(f.url)).json();
  const keys = String(polity || '').toLowerCase().split(/[,/|]/).map((x) => x.trim()).filter(Boolean);
  const m = repoRef.files[f.url].features.filter((ft) => { const p = ft.properties || {}, t = `${p.NAME || ''} ${p.SUBJECTO || ''} ${p.PARTOF || ''}`.toLowerCase(); return keys.some((k) => t.includes(k)); });
  if (!m.length) { step('No matching polity in the repo snapshot'); return null; }
  const rings = [];
  for (const ft of m) { const g = ft.geometry; if (!g) continue; if (g.type === 'Polygon') rings.push(thin(g.coordinates[0], 0.05)); else if (g.type === 'MultiPolygon') for (const p of g.coordinates) rings.push(thin(p[0], 0.05)); }
  const good = rings.filter((r) => r.length >= 3);
  return good.length ? { rings: good, name: m[0].properties.NAME || polity, year: f.y } : null;
}

// ----- pipeline -----
async function simple(cmd, c) {
  step('Tracing the shape with Gemini');
  const hh = (view.w * ch) / cw, bb = [x2lon(view.cx - view.w / 2), y2lat(view.cy + hh / 2), x2lon(view.cx + view.w / 2), y2lat(view.cy - hh / 2)].map((v) => +v.toFixed(1));
  const out = (await gem([{ text: `${cmd}\n\nCurrent view (west, south, east, north): ${bb.join(', ')}\nAlready drawn: ${feats.slice(-40).map((f) => f.name).join(', ') || 'nothing'}` }], { system: SYS })).data;
  if (!out) throw new Error('Gemini sent back something unreadable');
  step('Snapping to official coasts and borders');
  let n = 0, skipped = 0, flagged = 0;
  for (const f of (out.features || []).slice(0, 40)) {
    const okc = Array.isArray(f.coords) && f.coords.length >= (f.kind === 'river' ? 2 : 3) && f.coords.every((p) => Array.isArray(p) && Math.abs(p[0]) <= 180 && Math.abs(p[1]) <= 90);
    if (!okc || !KIND[f.kind]) { skipped++; continue; }
    let co = f.coords.slice(0, 120).map((p) => [+p[0], +p[1]]);
    if (f.kind !== 'river') co = snap(co, !!c?.land);
    const nf = addFeature({ kind: f.kind, name: String(f.name || 'Untitled'), parent: String(f.parent || ''), note: String(f.note || ''), ai: true, conf: ['high', 'medium', 'low'].includes(f.conf) ? f.conf : 'low', method: 'Traced by Gemini, snapped to official coast/borders', coords: co });
    n++; if (nf.flags.length || nf.conf === 'low') flagged++;
  }
  if (!n) { msg(out.error || 'Nothing could be drawn for that.', true); return; }
  const all = feats.slice(-n).map(bboxOf); fit([Math.min(...all.map((a) => a[0])), Math.min(...all.map((a) => a[1])), Math.max(...all.map((a) => a[2])), Math.max(...all.map((a) => a[3]))]);
  renderUser(); $('wm-info').innerHTML = '<div class="wm-muted">Done. Click an item to see its status.</div>';
  msg(`Added ${n}${flagged ? ` · ${flagged} need checking (⚠)` : ' · all passed checks'}${skipped ? ` · ${skipped} invalid skipped` : ''}. Still approximate.`, flagged > 0);
}

async function composed(c, cmd) {
  const hard = c.tier === 'hard', N = hard ? 3 : 1, when = c.year != null ? ` around the year ${yl(c.year)}` : '';
  step('Loading official state and district boundaries');
  await Promise.all([loadLayer('d'), loadLayer('f')]);
  step(`Searching the web (${N} pass${N > 1 ? 'es' : ''})${c.year != null ? ' and the historical map repo' : ''}`);
  const angles = ['', 'Prefer historians\' maps and encyclopedias.', 'Prefer Wikipedia and academic atlases.'].slice(0, N);
  const ask = (a) => `Search the web. Subject: "${c.subject || cmd}"${when}. List the modern administrative regions that were inside its territory at that time. Use the finest unit possible: Indian districts or states, or states/provinces of other countries; use a whole country only if essentially all of it was inside. Reply ONLY JSON: {"regions":[{"name":"modern English name","type":"india_district"|"india_state"|"world_state"|"country","parent":"State, Country or Country","part":"all"|"part"}]}. Max 60 regions. ${a}`;
  const [runs, ref] = await Promise.all([
    Promise.allSettled(angles.map((a) => gem([{ text: ask(a) }], { search: true }))),
    c.year != null ? repoRef(c.year, c.polity).catch((e) => { step('Repo skipped: ' + e.message); return null; }) : null,
  ]);
  const votes = new Map(); let ok = 0; const src = new Map();
  for (const r of runs) {
    if (r.status !== 'fulfilled' || !r.value.data?.regions) continue;
    ok++; r.value.sources.forEach((s) => src.set(s.uri, s)); const seen = new Set();
    for (const g of r.value.data.regions.slice(0, 80)) { const k = norm(g.name) + '|' + (g.type || ''); if (seen.has(k)) continue; seen.add(k); const v = votes.get(k) || { ...g, votes: 0 }; v.votes++; votes.set(k, v); }
  }
  if (!ok) { step('Web research failed, tracing instead'); return simple(cmd, c); }
  const need = ok >= 3 ? 2 : 1, picked = [...votes.values()].filter((v) => v.votes >= need);
  step(`${ok} pass${ok > 1 ? 'es' : ''} agreed on ${picked.length} regions · ${src.size} web sources`);
  const build = (list) => { const seen = new Set(), used = [], missing = []; for (const r of list) { const h = resolve(r); if (!h) { missing.push(r.name); continue; } if (seen.has(h.id)) continue; seen.add(h.id); used.push({ name: r.name, part: r.part, label: h.label, rings: h.rings }); } return { used, missing }; };
  let { used, missing } = build(picked);
  if (!used.length) { step('No official regions matched, tracing instead'); return simple(cmd, c); }
  const flat = () => used.flatMap((u) => u.rings);
  let score = ref ? iou(flat(), ref.rings) : null;
  step(`Composed from ${used.length} official regions${score != null ? ` · ${Math.round(score * 100)}% overlap with ${ref.name} (${yl(ref.year)})` : ''}`);

  const rounds = hard ? 3 : 2;
  for (let i = 1; i <= rounds; i++) {
    step(`Visual check ${i}/${rounds}: Gemini inspects the map`);
    const img = snapshot(flat(), ref?.rings, used);
    const names = used.map((u) => u.label).slice(0, 90).join('; ');
    const v = (await gem([{ text: `Image: RED = current shape for "${c.subject || cmd}"${when}. ${ref ? 'BLUE outline = reference shape from a historical atlas. ' : ''}Grey lines = modern borders with names. Included regions: ${names}. Judge whether RED matches the true extent at that time${ref ? ' and the blue reference' : ''}. Reply ONLY JSON {"ok":boolean,"remove":[names from the included list],"add":[{"name":"","type":"india_district"|"india_state"|"world_state"|"country","parent":""}],"note":""}. Be conservative: change only clear errors.` }, { inline_data: { mime_type: 'image/png', data: img } }])).data;
    if (!v) { step('No verdict, keeping the shape'); break; }
    if (v.ok) { step('Gemini: looks right'); break; }
    const rem = new Set((v.remove || []).map((x) => norm(String(x).split(',')[0]))), before = used.length;
    const kept = used.filter((u) => !rem.has(norm(u.label.split(',')[0])) && !rem.has(norm(u.name)));
    if (kept.length) used = kept;
    const adds = (v.add || []).map((a) => (typeof a === 'string' ? { name: a } : a)), b2 = build(adds), have = new Set(used.map((u) => u.label));
    let added = 0; for (const u of b2.used) if (!have.has(u.label)) { used.push(u); added++; }
    const removed = before - kept.length > 0 && kept.length ? before - kept.length : 0;
    step(`Adjusted: −${removed} +${added}${v.note ? ' · ' + v.note : ''}`);
    if (ref) score = iou(flat(), ref.rings);
    if (!removed && !added) break;
  }

  const rings = flat(), pct = score != null ? Math.round(score * 100) : null;
  const conf = score != null ? (score >= 0.75 ? 'high' : score >= 0.5 ? 'medium' : 'low') : hard ? 'low' : 'medium';
  const flags = [];
  if (score != null && score < 0.5) flags.push(`Only ${pct}% overlap with the reference`);
  if (missing.length > used.length * 0.2) flags.push(`Not matched to official shapes: ${missing.slice(0, 6).join(', ')}`);
  const partial = used.filter((u) => u.part === 'part').map((u) => u.label.split(',')[0]);
  const sources = [...src.values()].slice(0, 6);
  if (ref) addFeature({ kind: 'area', name: `${ref.name} (reference, ${yl(ref.year)})`, parent: '', note: 'Approximate polygon from the historical-basemaps repo.', ref: true, coords: ref.rings.slice().sort((a, b) => ringArea(b) - ringArea(a))[0], rings: ref.rings });
  const f = addFeature({
    kind: c.kind === 'river' ? 'area' : (KIND[c.kind] ? c.kind : 'area'), name: c.subject || cmd, parent: '', ai: true, conf, flags, sources,
    note: `Built from ${used.length} modern regions.${partial.length ? ' Only part of these was inside, whole region shown: ' + partial.slice(0, 8).join(', ') + '.' : ''}`,
    method: `Official regions · ${ok} web pass${ok > 1 ? 'es' : ''}${pct != null ? ` · ${pct}% match with ${ref.name} (${yl(ref.year)})` : ''}`,
    coords: rings.slice().sort((a, b) => ringArea(b) - ringArea(a))[0], rings,
  });
  fit(bboxOf(f)); select(f.id);
  msg(`Added ${f.name}${pct != null ? ` · ${pct}% match` : ''}${flags.length ? ' · needs checking (⚠)' : ''}. Still approximate.`, flags.length > 0);
}

async function run() {
  const cmd = $('wm-cmd').value.trim(), key = localStorage.getItem('vn-gemini-key');
  if (!cmd) return; if (!key) { msg('Add your Gemini key first (Key button).', true); return; }
  if (!world) { msg('Map is still loading.', true); return; }
  $('wm-run').disabled = true; steps = []; step('Classifying the request');
  try {
    const h = (view.w * ch) / cw, b = [x2lon(view.cx - view.w / 2), y2lat(view.cy + h / 2), x2lon(view.cx + view.w / 2), y2lat(view.cy - h / 2)].map((v) => +v.toFixed(1));
    const c = (await gem([{ text: `${cmd}\nCurrent view (west, south, east, north): ${b.join(', ')}` }], { system: CLS })).data;
    if (!c) throw new Error('Could not understand the request');
    if (c.tier === 'exists') { $('wm-info').innerHTML = '<div class="wm-muted">' + esc(c.reason || 'Already on the map') + '</div>'; msg(c.reason || 'Already on the map: hover it, or click it and press Use as chapter shape', true); }
    else { step(`Tier: ${c.tier}${c.year != null ? ' · ' + yl(c.year) : ''}`); await (c.tier === 'simple' ? simple(cmd, c) : composed(c, cmd)); }
  } catch (err) { msg('Error: ' + err.message, true); }
  $('wm-run').disabled = false;
}
$('wm-run').onclick = run; $('wm-cmd').addEventListener('keydown', (e) => { if (e.key === 'Enter') run(); });
window.vnMap = { addFeature, fit, get features() { return feats; } };

// Re-check older saved AI items so they carry a status too.
for (const f of feats) if (f.ai && !f.flags) f.flags = [];
setTool('pan'); renderUser(); init();
</script>

