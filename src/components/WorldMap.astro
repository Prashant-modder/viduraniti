}
const OFFICIAL = '<div class="wm-muted">Official boundary data.</div>';
function infoFor(el) {
  const k = el?.dataset?.k; if (!k) return '';
  if (k === 'd') { const d = loaded.d.districts[+el.dataset.i]; return `<div class="wm-it">${esc(d.n)}</div><div class="wm-is">District of ${esc(d.s)}</div><dl><dt>Census code</dt><dd>${esc(d.code)}</dd></dl><div class="wm-muted">Census 2011 boundary. Districts created later are not shown.</div>`; }
  if (k === 'f') { const s = loaded.f.byCountry[el.dataset.cc][+el.dataset.i], c = world.countries.find((x) => x.id === el.dataset.cc); return `<div class="wm-it">${esc(s.n)}</div><div class="wm-is">${esc(s.t || 'State / province')}${c ? ' of ' + esc(c.n) : ''}</div>${OFFICIAL}`; }
