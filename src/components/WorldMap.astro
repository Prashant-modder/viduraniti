let steps = [];
const step = (t) => { steps.push(t); $('wm-info').innerHTML = '<div class="wm-it">Working…</div><ol class="wm-steps">' + steps.map((x) => `<li>${esc(x)}</li>`).join('') + '</ol>'; msg(t); };

async function gem(parts, { system, search = false, json = !search } = {}) {
  const key = localStorage.getItem('vn-gemini-key'), model = localStorage.getItem('vn-gemini-model') || DEFAULT_MODEL;
  const body = { contents: [{ role: 'user', parts }], generationConfig: { temperature: 0 } };
  if (system) body.systemInstruction = { parts: [{ text: system }] };
  if (json) body.generationConfig.responseMimeType = 'application/json';
  if (search) body.tools = [{ google_search: {} }];
  const r = await fetch('https://generativelanguage.googleapis.com/v1beta/models/' + model + ':generateContent', { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-goog-api-key': key }, body: JSON.stringify(body) });
  const j = await r.json(); if (!r.ok) throw new Error(j.error?.message || r.status);
  const c = j.candidates?.[0], text = (c?.content?.parts || []).map((p) => p.text || '').join('');
  const m = text.replace(/```json|```/g, '').match(/\{[\s\S]*\}/); let data = null;
  try { data = JSON.parse(m ? m[0] : text); } catch {}
  const sources = (c?.groundingMetadata?.groundingChunks || []).map((g) => g.web).filter((w) => w?.uri).map((w) => ({ title: w.title || w.uri, uri: w.uri }));
  return { data, text, sources };
}

// ----- snapping to official coasts and borders -----
let grid = null;
function buildGrid() {
  grid = new Map();
  for (const c of world.countries) for (const r of allRings(c.d)) for (const p of r) { const k = `${Math.floor(p[0])}_${Math.floor(p[1])}`; (grid.get(k) || grid.set(k, []).get(k)).push(p); }
}
function nearest(p, max) {
  let best = null, bd = max * max; const k = Math.ceil(max), cx = Math.floor(p[0]), cy = Math.floor(p[1]);
  for (let i = -k; i <= k; i++) for (let j = -k; j <= k; j++) { const a = grid.get(`${cx + i}_${cy + j}`); if (a) for (const q of a) { const d = (q[0] - p[0]) ** 2 + (q[1] - p[1]) ** 2; if (d < bd) { bd = d; best = q; } } }
  return best;
}
const onLand = (lon, lat) => { const pt = new DOMPoint(lon2x(lon), lat2y(lat)); return ctEls.some((el) => el.isPointInFill(pt)); };
function snap(coords, land) {
  if (!grid) buildGrid();
