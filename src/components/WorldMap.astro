---
// src/components/WorldMap.astro
// Interactive world map. Every country and every Indian state is its own SVG path (a "sprite").
// Data: /data/world.json (node scripts/build-map-data.mjs). Other countries' states/districts, rivers and
// areas are drawn by hand with the tools or generated by Gemini (user's own key, stored in the browser).
---

<div class="wm" id="wm">
  <div class="wm-top">
    <input id="wm-cmd" type="text" placeholder='Ask Gemini: "states of Brazil", "districts of Rajasthan", "river Ganga", "Deccan plateau"' autocomplete="off" />
    <button id="wm-run" type="button">Generate</button>
    <button id="wm-key" type="button" title="Gemini API key (stays in this browser)">Key</button>
    <span id="wm-msg" class="wm-msg"></span>
  </div>

  <div class="wm-tools" id="wm-tools">
    <button data-tool="pan" class="on" title="Move / inspect">✋<small>Move</small></button>
    <button data-tool="state" title="Draw a state or province">▦<small>State</small></button>
    <button data-tool="district" title="Draw a district">▧<small>District</small></button>
    <button data-tool="area" title="Map an area (plateau, region, lake…)">◍<small>Area</small></button>
    <button data-tool="river" title="Trace a river">〰<small>River</small></button>
    <button data-tool="erase" title="Click a drawn item to delete it">⌫<small>Erase</small></button>
    <hr />
    <button id="wm-zin" title="Zoom in">＋</button>
    <button id="wm-zout" title="Zoom out">－</button>
    <button id="wm-world" title="Whole world">🌍<small>World</small></button>
    <button id="wm-india" title="Zoom to India">🇮🇳<small>India</small></button>
  </div>

  <div class="wm-stage" id="wm-stage">
    <svg id="wm-svg" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" role="img" aria-label="World map">
      <rect class="wm-sea" x="-5000" y="-5000" width="13600" height="11800" />
      <g id="wm-countries"></g>
      <g id="wm-india"></g>
      <g id="wm-user"></g>
      <g id="wm-labels"></g>
      <g id="wm-draft"></g>
    </svg>
    <div id="wm-tip" class="wm-tip" hidden></div>
    <div id="wm-hint" class="wm-hint"></div>
    <div id="wm-status" class="wm-status">Loading map…</div>
  </div>

  <aside class="wm-panel">
    <div id="wm-form" class="wm-form" hidden>
      <div class="wm-ptitle" id="wm-form-title">New item</div>
      <label>Name<input id="wm-f-name" type="text" /></label>
      <label>Inside<input id="wm-f-parent" type="text" /></label>
      <label>Details<textarea id="wm-f-note" rows="3" placeholder="Capital, population, source, length, notes…"></textarea></label>
      <div class="wm-row"><button id="wm-f-save" type="button" class="primary">Save</button><button id="wm-f-cancel" type="button">Cancel</button></div>
    </div>

    <div id="wm-info" class="wm-info"><div class="wm-muted">Hover or click a country, a state or a drawn item to see its details.</div></div>

    <div class="wm-ptitle">Your items <span id="wm-count"></span></div>
    <div id="wm-list" class="wm-list"></div>
    <div class="wm-row wrap">
      <button id="wm-export" type="button">Export</button>
      <button id="wm-import" type="button">Import</button>
      <button id="wm-clear-ai" type="button">Clear AI</button>
      <button id="wm-clear" type="button">Clear all</button>
      <input id="wm-file" type="file" accept=".json,.geojson" hidden />
    </div>
  </aside>
</div>

<script>
// @ts-nocheck
const $ = (id) => document.getElementById(id);
const svg = $('wm-svg'), stage = $('wm-stage'), tip = $('wm-tip');
const NS = 'http://www.w3.org/2000/svg';
const W = 3600, H = 1800;
const lon2x = (l) => (l + 180) * 10, lat2y = (a) => (90 - a) * 10;
const x2lon = (x) => x / 10 - 180, y2lat = (y) => 90 - y / 10;
const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
const KIND = { state: 'State', district: 'District', area: 'Area', river: 'River' };
const HINT = {
  pan: 'Drag to move, scroll or pinch to zoom. Hover for details.',
  state: 'Click to place corners. Double-click or Enter to finish, Backspace undoes, Esc cancels.',
  district: 'Click to place corners. Double-click or Enter to finish, Backspace undoes, Esc cancels.',
  area: 'Click to place corners. Double-click or Enter to finish, Backspace undoes, Esc cancels.',
  river: 'Click along the river from source to mouth. Double-click or Enter to finish.',
  erase: 'Click a drawn item to delete it.',
};

let world = null, tool = 'pan', draft = [], sel = null, ctEls = [], stEls = [];
let feats = [];
try { feats = JSON.parse(localStorage.getItem('vn-map-feats') || '[]'); } catch {}
const save = () => { try { localStorage.setItem('vn-map-feats', JSON.stringify(feats)); } catch {} };

// ---------- view ----------
const view = { cx: W / 2, cy: H / 2, w: W };
let cw = 1, ch = 1, scale = 1;
function size() { const r = stage.getBoundingClientRect(); cw = r.width || 1; ch = r.height || 1; }
let raf = 0;
function apply() {
  size();
  view.w = Math.min(Math.max(view.w, 12), Math.max(W, (H * cw) / ch));
  const h = (view.w * ch) / cw;
  view.cx = Math.min(Math.max(view.cx, 0), W); view.cy = Math.min(Math.max(view.cy, 0), H);
  scale = cw / view.w;
  svg.setAttribute('viewBox', `${view.cx - view.w / 2} ${view.cy - h / 2} ${view.w} ${h}`);
  svg.style.setProperty('--px', String(1 / scale));
  cancelAnimationFrame(raf); raf = requestAnimationFrame(() => { labels(); drawDraft(); });
}
function toSvg(e) {
  const r = svg.getBoundingClientRect(), h = (view.w * ch) / cw;
  return { x: view.cx - view.w / 2 + (e.clientX - r.left) / scale, y: view.cy - h / 2 + (e.clientY - r.top) / scale };
}
function zoomAt(f, e) {
  const p = e ? toSvg(e) : { x: view.cx, y: view.cy };
  const nw = Math.min(Math.max(view.w * f, 12), W * 1.2), k = nw / view.w;
  view.cx = p.x - (p.x - view.cx) * k; view.cy = p.y - (p.y - view.cy) * k; view.w = nw; apply();
}
function fit(b, pad = 1.35) {
  size();
  view.w = Math.max((b[2] - b[0]) * pad, ((b[3] - b[1]) * pad * cw) / ch, 24);
  view.cx = (b[0] + b[2]) / 2; view.cy = (b[1] + b[3]) / 2; apply();
}

// ---------- world ----------
function mk(tag, attrs, parent) { const el = document.createElementNS(NS, tag); for (const k in attrs) el.setAttribute(k, attrs[k]); parent?.appendChild(el); return el; }
async function init() {
  try {
    world = await (await fetch('/data/world.json')).json();
  } catch { $('wm-status').textContent = 'Could not load /data/world.json. Run: node scripts/build-map-data.mjs'; return; }
  const cg = $('wm-countries'), ig = $('wm-india'), lg = $('wm-labels');
  world.countries.forEach((c, i) => { ctEls.push(mk('path', { d: c.d, class: 'wm-ct', 'data-k': 'c', 'data-i': i, id: 'c-' + c.id }, cg)); });
  world.india.forEach((s, i) => { stEls.push(mk('path', { d: s.d, class: 'wm-st', 'data-k': 's', 'data-i': i }, ig)); });
  world.countries.forEach((c, i) => { if (c.r > 14) { const t = mk('text', { x: c.c[0], y: c.c[1], class: 'wm-lb c', 'text-anchor': 'middle' }, lg); t.textContent = c.n; t._r = c.r; t._k = 'c'; } });
  world.india.forEach((s) => { if (s.r > 6) { const t = mk('text', { x: s.c[0], y: s.c[1], class: 'wm-lb s', 'text-anchor': 'middle' }, lg); t.textContent = s.n; t._r = s.r; t._k = 's'; } });
  $('wm-status').textContent = `${world.countries.length} countries · ${world.india.length} Indian states and UTs`;
  renderUser(); apply();
}
function labels() {
  const hideC = view.w > W * 0.99 && false;
  for (const t of $('wm-labels').children) {
    const px = t._r * scale;
    t.style.display = t._k === 'c' ? (px > 58 && !(view.w < 500 && false) ? '' : 'none') : (px > 46 && view.w < 900 ? '' : 'none');
  }
}

// ---------- geometry helpers ----------
const ringArea = (c) => {
  const lat0 = c.reduce((a, p) => a + p[1], 0) / c.length, k = Math.cos((lat0 * Math.PI) / 180);
  let a = 0; for (let i = 0; i < c.length; i++) { const p = c[i], q = c[(i + 1) % c.length]; a += p[0] * k * 111.32 * q[1] * 110.57 - q[0] * k * 111.32 * p[1] * 110.57; }
  return Math.abs(a) / 2;
};
const hav = (p, q) => { const r = Math.PI / 180, dl = (q[1] - p[1]) * r, dn = (q[0] - p[0]) * r; const a = Math.sin(dl / 2) ** 2 + Math.cos(p[1] * r) * Math.cos(q[1] * r) * Math.sin(dn / 2) ** 2; return 12742 * Math.asin(Math.sqrt(a)); };
const lineLen = (c) => c.slice(1).reduce((s, p, i) => s + hav(c[i], p), 0);
const fmt = (n) => Math.round(n).toLocaleString('en-IN');
const pathOf = (f) => 'M' + f.coords.map((p) => `${lon2x(p[0]).toFixed(1)} ${lat2y(p[1]).toFixed(1)}`).join('L') + (f.kind === 'river' ? '' : 'Z');
const bboxOf = (f) => { const xs = f.coords.map((p) => lon2x(p[0])), ys = f.coords.map((p) => lat2y(p[1])); return [Math.min(...xs), Math.min(...ys), Math.max(...xs), Math.max(...ys)]; };
function locate(x, y) {
  const pt = new DOMPoint(x, y); let st = null, ct = null;
  for (const el of stEls) if (el.isPointInFill(pt)) { st = world.india[+el.dataset.i]; break; }
  for (const el of ctEls) if (el.isPointInFill(pt)) { ct = world.countries[+el.dataset.i]; break; }
  return { st, ct };
}

// ---------- user features ----------
function renderUser() {
  const g = $('wm-user'); g.innerHTML = '';
  for (const f of feats) mk('path', { d: pathOf(f), class: `wm-u ${f.kind}${f.ai ? ' ai' : ''}${sel === f.id ? ' sel' : ''}`, 'data-k': 'u', 'data-id': f.id }, g);
  $('wm-count').textContent = feats.length ? `(${feats.length})` : '';
  const l = $('wm-list'); l.innerHTML = '';
  for (const f of feats) {
    const b = document.createElement('button'); b.type = 'button'; b.className = 'wm-li';
    b.innerHTML = `<i class="dot ${f.kind}"></i><span>${esc(f.name)}</span><small>${KIND[f.kind]}${f.ai ? ' · AI' : ''}</small>`;
    b.onclick = () => { select(f.id); fit(bboxOf(f)); };
    l.appendChild(b);
  }
}
function addFeature(f) { f.id = f.id || 'u' + Date.now().toString(36) + Math.random().toString(36).slice(2, 5); feats.push(f); save(); renderUser(); return f; }
function select(id) { sel = id; renderUser(); const f = feats.find((x) => x.id === id); $('wm-info').innerHTML = f ? infoUser(f, true) : ''; wireDel(); }
function wireDel() { const b = document.getElementById('wm-del'); if (b) b.onclick = () => { feats = feats.filter((x) => x.id !== sel); sel = null; save(); renderUser(); $('wm-info').innerHTML = '<div class="wm-muted">Deleted.</div>'; }; }

// ---------- info ----------
function infoCountry(c) {
  return `<div class="wm-it">${esc(c.n)}</div>${c.f && c.f !== c.n ? `<div class="wm-is">${esc(c.f)}</div>` : ''}
  <dl><dt>Continent</dt><dd>${esc(c.cont)}${c.sub ? ' · ' + esc(c.sub) : ''}</dd>
  <dt>Population</dt><dd>${c.pop ? fmt(c.pop) : '—'}</dd><dt>Income group</dt><dd>${esc((c.inc || '').replace(/^\d\. /, '')) || '—'}</dd>
  <dt>ISO code</dt><dd>${esc(c.a3)}</dd></dl>${c.id === 'IND' ? '<div class="wm-muted">Zoom in to see the states and union territories.</div>' : '<div class="wm-muted">Use State / District tools or ask Gemini to add its states.</div>'}`;
}
const infoState = (s) => `<div class="wm-it">${esc(s.n)}</div><div class="wm-is">${esc(s.type || 'State')} of India</div>
  <dl><dt>Code</dt><dd>${esc(s.code || '—')}</dd>${s.region ? `<dt>Region</dt><dd>${esc(s.region)}</dd>` : ''}</dl><div class="wm-muted">Use the District tool to map its districts.</div>`;
function infoUser(f, del) {
  const m = f.kind === 'river' ? `≈ ${fmt(lineLen(f.coords))} km long` : `≈ ${fmt(ringArea(f.coords))} km²`;
  return `<div class="wm-it">${esc(f.name)}</div><div class="wm-is">${KIND[f.kind]}${f.parent ? ' in ' + esc(f.parent) : ''}</div>
  <dl><dt>Size</dt><dd>${m}</dd>${f.note ? `<dt>Details</dt><dd>${esc(f.note)}</dd>` : ''}</dl>
  ${f.ai ? '<div class="wm-muted">Drawn by AI. Outline is approximate, check before publishing.</div>' : ''}
  ${del ? '<button id="wm-del" type="button">Delete</button>' : ''}`;
}
function infoFor(el) {
  const k = el?.dataset?.k; if (!k) return '';
  if (k === 'c') return infoCountry(world.countries[+el.dataset.i]);
  if (k === 's') return infoState(world.india[+el.dataset.i]);
  const f = feats.find((x) => x.id === el.dataset.id); return f ? infoUser(f, false) : '';
}

// ---------- drawing ----------
function drawDraft() {
  const g = $('wm-draft'); g.innerHTML = '';
  if (!draft.length) return;
  const pts = draft.map((p) => `${lon2x(p[0])} ${lat2y(p[1])}`);
  mk('path', { d: 'M' + pts.join('L') + (tool !== 'river' && draft.length > 2 ? 'Z' : ''), class: 'wm-dr' }, g);
  draft.forEach((p, i) => mk('circle', { cx: lon2x(p[0]), cy: lat2y(p[1]), r: (i === 0 ? 6 : 4) / scale, class: 'wm-dv' }, g));
}
function setTool(t) {
  if (draft.length) { draft = []; drawDraft(); }
  tool = t; document.querySelectorAll('#wm-tools [data-tool]').forEach((b) => b.classList.toggle('on', b.dataset.tool === t));
  stage.dataset.tool = t; $('wm-hint').textContent = HINT[t];
}
function finish() {
  const river = tool === 'river';
  if (draft.length < (river ? 2 : 3)) { draft = []; drawDraft(); return; }
  const first = draft[0], { st, ct } = locate(lon2x(first[0]), lat2y(first[1]));
  const parent = tool === 'district' && st ? `${st.n}, India` : ct ? ct.n : '';
  $('wm-form-title').textContent = `New ${KIND[tool].toLowerCase()}`;
  $('wm-f-name').value = ''; $('wm-f-parent').value = parent; $('wm-f-note').value = '';
  $('wm-form').hidden = false; $('wm-f-name').focus();
  $('wm-form').dataset.kind = tool;
}
$('wm-f-save').onclick = () => {
  const name = $('wm-f-name').value.trim(); if (!name) { $('wm-f-name').focus(); return; }
  const f = addFeature({ kind: $('wm-form').dataset.kind, name, parent: $('wm-f-parent').value.trim(), note: $('wm-f-note').value.trim(), coords: draft.slice() });
  draft = []; drawDraft(); $('wm-form').hidden = true; select(f.id);
};
$('wm-f-cancel').onclick = () => { draft = []; drawDraft(); $('wm-form').hidden = true; };

// ---------- pointer ----------
const ptrs = new Map(); let moved = false, start = null, pinch = 0;
svg.addEventListener('pointerdown', (e) => {
  svg.setPointerCapture(e.pointerId); ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
  if (ptrs.size === 1) { moved = false; start = { x: e.clientX, y: e.clientY, cx: view.cx, cy: view.cy }; }
  if (ptrs.size === 2) { const [a, b] = [...ptrs.values()]; pinch = Math.hypot(a.x - b.x, a.y - b.y); moved = true; }
});
svg.addEventListener('pointermove', (e) => {
  const lon = x2lon(toSvg(e).x), lat = y2lat(toSvg(e).y);
  if (world) $('wm-status').textContent = `${lat.toFixed(2)}°, ${lon.toFixed(2)}°`;
  if (ptrs.has(e.pointerId)) {
    ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (ptrs.size === 2) {
      const [a, b] = [...ptrs.values()], d = Math.hypot(a.x - b.x, a.y - b.y);
      if (pinch) zoomAt(pinch / d, { clientX: (a.x + b.x) / 2, clientY: (a.y + b.y) / 2 }); pinch = d; return;
    }
    if (start && (moved || Math.hypot(e.clientX - start.x, e.clientY - start.y) > 5)) {
      moved = true; view.cx = start.cx - (e.clientX - start.x) / scale; view.cy = start.cy - (e.clientY - start.y) / scale; apply(); tip.hidden = true; return;
    }
  }
  const el = e.target.closest?.('[data-k]');
  const html = el ? infoFor(el) : '';
  if (html && !ptrs.size) {
    tip.innerHTML = html; tip.hidden = false;
    const r = stage.getBoundingClientRect(), tw = tip.offsetWidth, th = tip.offsetHeight;
    tip.style.left = Math.min(e.clientX - r.left + 14, r.width - tw - 8) + 'px';
    tip.style.top = Math.min(e.clientY - r.top + 14, r.height - th - 8) + 'px';
  } else tip.hidden = true;
});
svg.addEventListener('pointerleave', () => { tip.hidden = true; });
svg.addEventListener('pointerup', (e) => {
  ptrs.delete(e.pointerId); if (ptrs.size < 2) pinch = 0;
  if (moved || !world) return;
  const el = e.target.closest?.('[data-k]');
  if (tool === 'erase') { if (el?.dataset.k === 'u') { feats = feats.filter((f) => f.id !== el.dataset.id); save(); renderUser(); } return; }
  if (['state', 'district', 'area', 'river'].includes(tool)) {
    if ($('wm-form').hidden === false) return;
    const p = toSvg(e); draft.push([+x2lon(p.x).toFixed(3), +y2lat(p.y).toFixed(3)]); drawDraft(); return;
  }
  if (el?.dataset.k === 'u') select(el.dataset.id);
  else if (el) { sel = null; renderUser(); $('wm-info').innerHTML = infoFor(el); }
});
svg.addEventListener('dblclick', (e) => { if (['state', 'district', 'area', 'river'].includes(tool) && $('wm-form').hidden) { draft.pop(); finish(); } });
svg.addEventListener('wheel', (e) => { e.preventDefault(); zoomAt(e.deltaY > 0 ? 1.18 : 1 / 1.18, e); }, { passive: false });
window.addEventListener('keydown', (e) => {
  if (/INPUT|TEXTAREA/.test(document.activeElement?.tagName)) return;
  if (e.key === 'Enter' && draft.length) finish();
  else if (e.key === 'Escape') { draft = []; drawDraft(); $('wm-form').hidden = true; }
  else if (e.key === 'Backspace' && draft.length) { e.preventDefault(); draft.pop(); drawDraft(); }
});
window.addEventListener('resize', apply);
document.querySelectorAll('#wm-tools [data-tool]').forEach((b) => (b.onclick = () => setTool(b.dataset.tool)));
$('wm-zin').onclick = () => zoomAt(1 / 1.5); $('wm-zout').onclick = () => zoomAt(1.5);
$('wm-world').onclick = () => { view.cx = W / 2; view.cy = H / 2; view.w = W; apply(); };
$('wm-india').onclick = () => { const c = world?.countries.find((x) => x.id === 'IND'); if (c) fit(c.b, 1.2); };

// ---------- import / export ----------
$('wm-export').onclick = () => {
  const gj = { type: 'FeatureCollection', features: feats.map((f) => ({ type: 'Feature', properties: { kind: f.kind, name: f.name, parent: f.parent, note: f.note, ai: !!f.ai }, geometry: f.kind === 'river' ? { type: 'LineString', coordinates: f.coords } : { type: 'Polygon', coordinates: [[...f.coords, f.coords[0]]] } })) };
  const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([JSON.stringify(gj, null, 1)], { type: 'application/geo+json' })); a.download = 'viduraniti-map.geojson'; a.click();
};
$('wm-import').onclick = () => $('wm-file').click();
$('wm-file').onchange = async (e) => {
  try {
    const gj = JSON.parse(await e.target.files[0].text());
    for (const ft of gj.features || []) {
      const g = ft.geometry, p = ft.properties || {}; if (!g) continue;
      const line = g.type === 'LineString', c = line ? g.coordinates : g.type === 'Polygon' ? g.coordinates[0].slice(0, -1) : null; if (!c) continue;
      addFeature({ kind: line ? 'river' : KIND[p.kind] ? p.kind : 'area', name: p.name || 'Untitled', parent: p.parent || '', note: p.note || '', ai: !!p.ai, coords: c.map((q) => [q[0], q[1]]) });
    }
  } catch { msg('That file could not be read.'); }
  e.target.value = '';
};
$('wm-clear-ai').onclick = () => { feats = feats.filter((f) => !f.ai); save(); renderUser(); };
$('wm-clear').onclick = () => { if (confirm('Delete everything you drew?')) { feats = []; save(); renderUser(); } };

// ---------- Gemini ----------
const msg = (t, err) => { const m = $('wm-msg'); m.textContent = t; m.classList.toggle('err', !!err); };
$('wm-key').onclick = () => {
  const k = prompt('Gemini API key (kept only in this browser):', localStorage.getItem('vn-gemini-key') || '');
  if (k !== null) { try { localStorage.setItem('vn-gemini-key', k.trim()); } catch {} msg(k.trim() ? 'Key saved.' : 'Key removed.'); }
};
const SYS = `You are a careful cartographer for an educational world map. Reply with ONLY JSON:
{"features":[{"kind":"state"|"district"|"area"|"river","name":string,"parent":string,"note":string,"coords":[[lon,lat],...]}],"error":string?}
Rules: WGS84 degrees, [lon,lat] order. Polygons: ring without repeating the first point, 10-70 vertices, following the real boundary as closely as you can; neighbouring regions must reuse the same vertices on shared borders so they fit together. Rivers: ordered source to mouth, 15-90 points, following the real course. "parent" = the country (districts: "State, Country"). "note" = one factual sentence under 25 words. Use the usual English names. Do not invent places; if unsure or the request is not about geography return {"features":[],"error":"reason"}. India's states already exist on the map: for India draw districts, rivers or areas, not states, unless asked. Maximum 40 features.`;
async function run() {
  const cmd = $('wm-cmd').value.trim(), key = localStorage.getItem('vn-gemini-key');
  if (!cmd) return; if (!key) { msg('Add your Gemini key first (Key button).', true); return; }
  const h = (view.w * ch) / cw, b = [x2lon(view.cx - view.w / 2), y2lat(view.cy + h / 2), x2lon(view.cx + view.w / 2), y2lat(view.cy - h / 2)].map((v) => +v.toFixed(1));
  $('wm-run').disabled = true; msg('Generating…');
  try {
    const r = await fetch('https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent', {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'x-goog-api-key': key },
