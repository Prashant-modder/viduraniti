  const models = [...new Set([(search && localStorage.getItem('vn-gemini-search')) || localStorage.getItem('vn-gemini-model') || DEFAULT_MODEL, localStorage.getItem('vn-gemini-fallback')].filter(Boolean))];
  const body = { contents: [{ role: 'user', parts }], generationConfig: { temperature: 0 } };
  if (system) body.systemInstruction = { parts: [{ text: system }] };
