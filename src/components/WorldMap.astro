  }
  if (!n) { msg(out.error || 'Nothing could be drawn for that.', true); return; }
  const all = feats.slice(-n).map(bboxOf); fit([Math.min(...all.map((a) => a[0])), Math.min(...all.map((a) => a[1])), Math.max(...all.map((a) => a[2])), Math.max(...all.map((a) => a[3]))]);
  renderUser(); $('wm-info').innerHTML = '<div class="wm-muted">Done. Click an item to see its status.</div>';
  msg(`Added ${n}${flagged ? ` · ${flagged} need checking (⚠)` : ' · all passed checks'}${skipped ? ` · ${skipped} invalid skipped` : ''}. Still approximate.`, flagged > 0);
}

async function composed(c, cmd) {
  const hard = c.tier === 'hard', N = hard ? 3 : 1, when = c.year != null ? ` around the year ${yl(c.year)}` : '';
  step('Loading official state and district boundaries');
  await Promise.all([loadLayer('d'), loadLayer('f')]);
  step(`Searching the web (${N} pass${N > 1 ? 'es' : ''})${c.year != null ? ' and the historical map repo' : ''}`);
  const angles = ['', 'Prefer historians\' maps and encyclopedias.', 'Prefer Wikipedia and academic atlases.'].slice(0, N);
  const what = c.natural ? 'List the modern administrative regions (districts or states/provinces) where this natural feature mainly lies. Include a region only if the feature covers roughly half or more of it, and mark part:"part" if the feature covers less than the whole region.' : 'List the modern administrative regions that were inside its territory at that time.';
  const unit = c.natural ? 'Use the finest unit possible: Indian districts or states, or states/provinces of other countries; use a whole country only if essentially all of it was inside.' : 'List whole modern countries when essentially all of the country was inside the territory. Use states, provinces or Indian districts only when a country was only partly inside. Be exhaustive: list every colony, dominion, protectorate, mandate and territory. Never list cities or islands; give the modern country or state that contains them instead.';
  const ask = (a) => `Search the web. Subject: "${c.subject || cmd}"${when}. ${what} ${unit} Reply ONLY JSON: {"regions":[{"name":"modern English name","type":"india_district"|"india_state"|"world_state"|"country","parent":"State, Country or Country","part":"all"|"part"}]}. Use district names and boundaries as in the 2011 Census (for example Kachchh, Banas Kantha, Jalor). Do not use districts created after 2011; name the 2011 district they were carved from instead. Max ${hard ? 120 : 60} regions. ${a}`;
  const research = async (a) => {
    const p = [{ text: ask(a) }]; let r;
    try { r = await gem(p, { search: true }); } catch (e) { step('Web search failed: ' + String(e.message).slice(0, 140)); }
    if (!r?.data?.regions) { if (r) step('Search reply was not readable JSON'); step("Using Gemini's own knowledge instead of the web"); r = await gem(p, { search: false }); r.sources = []; }
    return r;
  };
  const wikiTask = (async () => {
    try {
      const w = await wikiMaps(c.subject || cmd, String(c.polity || '').split(',').map((x) => x.trim()).filter(Boolean));
      if (!w || !w.images.length) { step('Wikipedia: no map images found' + (w ? ` in "${w.title}"` : '')); return null; }
      step(`Wikipedia "${w.title}": reading ${w.images.length} map image${w.images.length > 1 ? 's' : ''} and noting the coloured areas`);
      const txt = `Candidate maps from the Wikipedia article "${w.title}", images 1 to ${w.images.length} in this order: ${w.images.map((i) => i.name).join(' | ')}. Subject: "${c.subject || cmd}"${when}. Pick the map that best shows this subject at that time, where the territory is highlighted in a colour against a neutral background. Notice which areas are highlighted and list the modern regions that are highlighted. ${unit} Reply ONLY JSON {"best":1-based index or null if no map fits,"regions":[{"name":"","type":"india_district"|"india_state"|"world_state"|"country","parent":"","part":"all"|"part"}],"note":""}.`;
      const d = (await gem([{ text: txt }, ...w.images.map((i) => ({ inline_data: { mime_type: i.mime, data: i.data } }))])).data;
      if (!d || d.best == null || !d.regions?.length) { step('Wikipedia maps do not match the subject'); return null; }
      const img = w.images[Math.min(Math.max(+d.best - 1, 0), w.images.length - 1)];
      step(`Wikipedia map read: ${d.regions.length} highlighted regions (${img.name})`);
      return { regions: d.regions, img, note: d.note, sources: [{ title: 'Wikipedia: ' + w.title, uri: 'https://en.wikipedia.org/wiki/' + encodeURIComponent(w.title.replace(/ /g, '_')) }] };
    } catch (e) { step('Wikipedia skipped: ' + String(e.message).slice(0, 100)); return null; }
  })();
  const [runs, ref, wk] = await Promise.all([
    Promise.allSettled(angles.map(research)),
    c.year != null ? repoRef(c.year, c.polity).catch((e) => { step('Repo skipped: ' + e.message); return null; }) : null,
    wikiTask,
  ]);
  const votes = new Map(); let ok = 0; const src = new Map();
  const sets = [...runs.filter((r) => r.status === 'fulfilled').map((r) => r.value), ...(wk ? [{ data: { regions: wk.regions }, sources: wk.sources }] : [])];
  for (const r of sets) {
    if (!r.data?.regions) continue;
    ok++; r.sources.forEach((s) => src.set(s.uri, s)); const seen = new Set();
    for (const g of r.data.regions.slice(0, 150)) { const k = norm(g.name) + '|' + (g.type || ''); if (seen.has(k)) continue; seen.add(k); const v = votes.get(k) || { ...g, votes: 0 }; v.votes++; if (g.part === 'part') v.part = 'part'; votes.set(k, v); }
  }
  if (!ok) { step('Research failed: ' + String(runs.find((r) => r.status === 'rejected')?.reason?.message || 'unreadable reply').slice(0, 140) + '. Tracing instead'); return simple(cmd, c); }
  const need = ok >= 3 ? 2 : 1; let picked = [...votes.values()].filter((v) => v.votes >= need);
  cur.classify = c; cur.need = need;
  cur.passes = runs.map((r) => r.status === 'fulfilled' ? { regions: r.value.data?.regions, sources: r.value.sources, raw: String(r.value.text).slice(0, 5000) } : { error: String(r.reason?.message) });
  if (wk) cur.passes.push({ wikipedia: true, regions: wk.regions, sources: wk.sources, raw: wk.note || '' });
  cur.votes = [...votes.values()].map((v) => ({ name: v.name, type: v.type, parent: v.parent, part: v.part, votes: v.votes }));
  step(`${ok} pass${ok > 1 ? 'es' : ''} agreed on ${picked.length} regions · ${src.size} web sources`);
  // A state that was only partly inside is replaced by the districts that were inside.
  const inState = (r) => (d) => d.type === 'india_district' && norm(String(d.parent || '').split(',')[0]) === norm(r.name);
  const partials = picked.filter((r) => r.part === 'part' && r.type === 'india_state' && !picked.some(inState(r)));
  if (partials.length) {
    step(`Asking which districts were inside the ${partials.length} partly included state${partials.length > 1 ? 's' : ''}`);
    try {
      const d = (await gem([{ text: `Subject: "${c.subject || cmd}"${when}. These Indian states were only partly inside its territory: ${partials.map((r) => r.name).join(', ')}. For each, list the 2011 Census districts that were inside. Reply ONLY JSON {"regions":[{"name":"","type":"india_district","parent":"State name","part":"all"}]}. Max 80 regions.` }])).data;
      for (const g of d?.regions || []) if (g.name) picked.push({ ...g, type: 'india_district', votes: need, part: 'all' });
    } catch (e) { step('District lookup skipped: ' + String(e.message).slice(0, 80)); }
  }
  picked = picked.filter((r) => !(r.part === 'part' && r.type === 'india_state' && picked.some(inState(r))));
  const build = (list) => { const seen = new Set(), used = [], missing = []; for (const r of list) { const h = resolve(r); if (!h) { missing.push(r.name); continue; } if (seen.has(h.id)) continue; if (c.natural && r.part === 'part' && /^[cf]/.test(h.id)) { missing.push(r.name); continue; } seen.add(h.id); used.push({ name: r.name, part: r.part, label: h.label, rings: h.rings }); } return { used, missing }; };
  let { used, missing } = build(picked);
  if (!used.length) { step('No official regions matched, tracing instead'); return simple(cmd, c); }
  const flat = () => used.flatMap((u) => u.rings);
  let score = ref ? iou(flat(), ref.rings) : null;
  step(`Composed from ${used.length} official regions${score != null ? ` · ${Math.round(score * 100)}% overlap with ${ref.name} (${yl(ref.year)})` : ''}`);

  const rounds = hard ? 3 : 2;
  for (let i = 1; i <= rounds; i++) {
    step(`Visual check ${i}/${rounds}: Gemini inspects the map`);
    const img = snapshot(flat(), ref?.rings, used);
    const names = used.map((u) => u.label).slice(0, 90).join('; ');
    const v = (await gem([{ text: `Image: RED = current shape for "${c.subject || cmd}"${when}. ${ref ? 'BLUE outline = reference shape from a historical atlas. ' : ''}Grey lines = modern borders with names. Included regions: ${names}. ${wk ? 'The SECOND image is a reference map from Wikipedia (the highlighted colour is the territory). Compare which areas are highlighted there with the RED areas in the first image and fix the differences. ' : ''}Judge whether RED matches the true extent at that time${ref ? ' and the blue reference' : ''}. Reply ONLY JSON {"ok":boolean,"remove":[names from the included list],"add":[{"name":"","type":"india_district"|"india_state"|"world_state"|"country","parent":""}],"note":""}. Be conservative: change only clear errors.` }, { inline_data: { mime_type: 'image/png', data: img } }, ...(wk ? [{ inline_data: { mime_type: wk.img.mime, data: wk.img.data } }] : [])])).data;
    (cur.rounds ??= []).push(v || { error: 'no verdict' });
    if (!v) { step('No verdict, keeping the shape'); break; }
    if (v.ok) { step('Gemini: looks right'); break; }
    const rem = new Set((v.remove || []).map((x) => norm(String(x).split(',')[0]))), before = used.length;
    let kept = used.filter((u) => !rem.has(norm(u.label.split(',')[0])) && !rem.has(norm(u.name)));
    if (before - kept.length > before * 0.4) { step(`Ignored: Gemini wanted to remove ${before - kept.length} of ${before} regions at once`); kept = used; }
    if (kept.length) used = kept;
    const adds = (v.add || []).map((a) => (typeof a === 'string' ? { name: a } : a)), b2 = build(adds), have = new Set(used.map((u) => u.label));
    let added = 0; for (const u of b2.used) if (!have.has(u.label)) { used.push(u); added++; }
    const removed = before - kept.length > 0 && kept.length ? before - kept.length : 0;
    step(`Adjusted: −${removed} +${added}${v.note ? ' · ' + v.note : ''}`);
    if (ref) score = iou(flat(), ref.rings);
    if (!removed && !added) break;
  }

  let traced = null;
  if (wk) {
    step('Placing the Wikipedia map on the globe and tracing its coloured area');
    try { traced = await traceWiki(wk.img, c.subject || cmd); cur.trace = { rmse: traced.rmse, areas: traced.rings.length, file: wk.img.name }; step(`Traced ${traced.rings.length} area${traced.rings.length > 1 ? 's' : ''} · placement error about ${traced.rmse.toFixed(2)}°`); }
    catch (e) { step('Map tracing skipped: ' + String(e.message).slice(0, 140)); }
  }
  const rings = flat(), pct = score != null ? Math.round(score * 100) : null;
  const conf = score != null ? (score >= 0.75 ? 'high' : score >= 0.5 ? 'medium' : 'low') : hard ? 'low' : 'medium';
  const flags = [];
  if (score != null && score < 0.5 && iou.mode === 'full') flags.push(`Only ${pct}% overlap with the reference`);
  if (missing.length > used.length * 0.2) flags.push(`Not covered, no matching official shape: ${missing.slice(0, 6).join(', ')}`);
  const partial = used.filter((u) => u.part === 'part').map((u) => u.label.split(',')[0]);
  const sources = [...src.values()].slice(0, 6);
  cur.used = used.map((u) => u.label); cur.missing = missing; cur.ref = ref ? { name: ref.name, year: ref.year } : null; cur.score = score; cur.flags = flags;
  if (ref) addFeature({ kind: 'area', name: `${ref.name} (reference, ${yl(ref.year)})`, parent: '', note: 'Approximate polygon from the historical-basemaps repo.', ref: true, coords: ref.rings.slice().sort((a, b) => ringArea(b) - ringArea(a))[0], rings: ref.rings });
  if (traced) addFeature({
    kind: 'area', name: `${c.subject || cmd} (traced from Wikipedia map)`, parent: '', ai: true, conf: traced.rmse < 1 ? 'high' : traced.rmse < 2 ? 'medium' : 'low',
    flags: traced.rmse > 2 ? [`Placement error about ${traced.rmse.toFixed(1)}°, edges are rough`] : [], sources: wk.sources, logId: cur.id,
    note: 'Coloured area cut out of a Wikipedia map image.', method: `Traced from ${wk.img.name} · ${traced.n} reference points · placement error about ${traced.rmse.toFixed(2)}°`,
    coords: traced.rings.slice().sort((a, b) => ringArea(b) - ringArea(a))[0], rings: traced.rings,
  });
  const f = addFeature({
    kind: c.kind === 'river' ? 'area' : (KIND[c.kind] ? c.kind : 'area'), name: c.subject || cmd, parent: '', ai: true, conf, flags, sources, logId: cur.id,
    note: `Built from ${used.length} modern regions.${partial.length ? ' Only part of these was inside, whole region shown: ' + partial.slice(0, 8).join(', ') + '.' : ''}`,
    method: `Official regions · ${ok} web pass${ok > 1 ? 'es' : ''}${pct != null ? ` · ${pct}% ${iou.mode === 'core' ? 'of the reference core (small polygon) is inside' : 'match with'} ${ref.name} (${yl(ref.year)})` : ''}`,
    coords: rings.slice().sort((a, b) => ringArea(b) - ringArea(a))[0], rings,
  });
  fit(bboxOf(f)); select(f.id);
  msg(`Added ${f.name}${pct != null ? ` · ${pct}% match` : ''}${flags.length ? ' · needs checking (⚠)' : ''}. Still approximate.`, flags.length > 0);
}

async function run() {
  const cmd = $('wm-cmd').value.trim(), key = localStorage.getItem('vn-gemini-key');
  if (!cmd) return; if (!key) { msg('Add your Gemini key first (Key button).', true); return; }
  if (!world) { msg('Map is still loading.', true); return; }
  $('wm-run').disabled = true; steps = []; cur = { id: 'l' + Date.now().toString(36), cmd, time: new Date().toISOString(), steps }; step('Classifying the request');
  try {
    const h = (view.w * ch) / cw, b = [x2lon(view.cx - view.w / 2), y2lat(view.cy + h / 2), x2lon(view.cx + view.w / 2), y2lat(view.cy - h / 2)].map((v) => +v.toFixed(1));
    const c = (await gem([{ text: `${cmd}\nCurrent view (west, south, east, north): ${b.join(', ')}` }], { system: CLS })).data;
    if (!c) throw new Error('Could not understand the request');
    if (c.tier === 'exists') {
      const q = norm(c.subject || cmd), qc = norm(cmd), hit = (n) => { n = norm(n); return n && (q === n || qc === n || qc.includes(n)); };
      const real = world.countries.some((k) => hit(k.n) || hit(k.f)) || world.india.some((k) => hit(k.n)) || (loaded.d?.districts || []).some((k) => hit(k.n)) || (loaded.f ? Object.values(loaded.f.byCountry).some((a) => a.some((k) => hit(k.n))) : false) || (loaded.r?.rivers || []).some((k) => hit(k.n));
      if (!real) { c.tier = 'medium'; c.natural = c.natural ?? true; }
    }
    if (c.tier === 'exists') { $('wm-info').innerHTML = '<div class="wm-muted">' + esc(c.reason || 'Already on the map') + '</div>'; msg(c.reason || 'Already on the map: hover it, or click it and press Use as chapter shape', true); }
    else { step(`Tier: ${c.tier}${c.year != null ? ' · ' + yl(c.year) : ''}`); await (c.tier === 'simple' ? simple(cmd, c) : composed(c, cmd)); }
  } catch (err) { if (cur) cur.error = String(err.message); msg('Error: ' + err.message, true); }
  saveLog(); renderLogs(); $('wm-run').disabled = false;
}
$('wm-run').onclick = run; $('wm-cmd').addEventListener('keydown', (e) => { if (e.key === 'Enter') run(); });
window.vnMap = { addFeature, fit, get features() { return feats; } };

// Re-check older saved AI items so they carry a status too.
for (const f of feats) if (f.ai && !f.flags) f.flags = [];
$('wm-logclear').onclick = () => { try { localStorage.removeItem('vn-map-logs'); } catch {} renderLogs(); };
setTool('pan'); renderUser(); renderLogs(); init();
</script>

