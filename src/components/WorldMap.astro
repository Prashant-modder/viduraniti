    });
    const j = await r.json(); if (!r.ok) throw new Error(j.error?.message || r.status);
    const out = JSON.parse(j.candidates[0].content.parts.map((p) => p.text).join(''));
    let n = 0, first = null;
    for (const f of (out.features || []).slice(0, 40)) {
      const okc = Array.isArray(f.coords) && f.coords.length >= (f.kind === 'river' ? 2 : 3) && f.coords.every((p) => Array.isArray(p) && Math.abs(p[0]) <= 180 && Math.abs(p[1]) <= 90);
      if (!okc || !KIND[f.kind]) continue;
      const nf = addFeature({ kind: f.kind, name: String(f.name || 'Untitled'), parent: String(f.parent || ''), note: String(f.note || ''), ai: true, coords: f.coords.slice(0, 120).map((p) => [+p[0], +p[1]]) });
      first = first || nf; n++;
    }
    if (n) { const all = feats.slice(-n).map(bboxOf); fit([Math.min(...all.map((a) => a[0])), Math.min(...all.map((a) => a[1])), Math.max(...all.map((a) => a[2])), Math.max(...all.map((a) => a[3]))]); msg(`Added ${n} item${n > 1 ? 's' : ''}. Outlines are approximate.`); }
    else msg(out.error || 'Nothing could be drawn for that.', true);
  } catch (err) { msg('Gemini error: ' + err.message, true); }
  $('wm-run').disabled = false;
}
$('wm-run').onclick = run; $('wm-cmd').addEventListener('keydown', (e) => { if (e.key === 'Enter') run(); });
window.vnMap = { addFeature, fit, get features() { return feats; } };

setTool('pan'); renderUser(); init();
</script>

