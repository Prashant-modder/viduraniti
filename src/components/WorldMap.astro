const step = (t) => { steps.push(t); $('wm-info').innerHTML = '<div class="wm-it">Working…</div><div class="wm-muted">' + esc(t) + '</div><div class="wm-muted">All steps are in the Run log below.</div>'; renderLogs(); msg(t); };

