}
const infoState = (s) => `<div class="wm-it">${esc(s.n)}</div><div class="wm-is">${esc(s.type || 'State')} of India</div>
  <dl><dt>Code</dt><dd>${esc(s.code || '—')}</dd>${s.region ? `<dt>Region</dt><dd>${esc(s.region)}</dd>` : ''}</dl><div class="wm-muted">Use the District tool to map its districts.</div>`;
function infoUser(f, del) {
  const m = f.kind === 'river' ? `≈ ${fmt(lineLen(f.coords))} km long` : `≈ ${fmt(featArea(f))} km²`, s = statusOf(f);
  return `<div class="wm-it">${esc(f.name)}</div><div class="wm-is">${KIND[f.kind]}${f.parent ? ' in ' + esc(f.parent) : ''}</div>
  <dl><dt>Size</dt><dd>${m}</dd>${f.note ? `<dt>Details</dt><dd>${esc(f.note)}</dd>` : ''}<dt>Status</dt><dd><span class="wm-badge ${s}">${STATUS[s]}</span></dd>${f.method ? `<dt>Method</dt><dd>${esc(f.method)}</dd>` : ''}</dl>
  ${f.sources?.length ? `<div class="wm-muted">Sources: ${f.sources.filter((x) => /^https?:/.test(x.uri)).map((x) => `<a href="${esc(x.uri)}" target="_blank" rel="noopener noreferrer">${esc(x.title)}</a>`).join(' · ')}</div>` : ''}
