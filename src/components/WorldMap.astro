// ---------- Gemini ----------
const msg = (t, err) => { const m = $('wm-msg'); m.textContent = t; m.classList.toggle('err', !!err); };
const DEFAULT_MODEL = 'gemini-3.8-flash';
$('wm-key').onclick = () => {
  const k = prompt('Gemini API key (kept only in this browser):', localStorage.getItem('vn-gemini-key') || '');
  if (k === null) return;
  const m = prompt('Gemini model (change this if Google retires it):', localStorage.getItem('vn-gemini-model') || DEFAULT_MODEL);
  const k2 = prompt('Second API key, used when the first is busy or out of quota (optional):', localStorage.getItem('vn-gemini-key2') || '');
  const sm = prompt('Model for web-search steps (needs free Google Search grounding, e.g. a 2.5 Flash model). Leave empty to use the main model:', localStorage.getItem('vn-gemini-search') || '');
  const fb = prompt('Fallback model used when the main one is busy (optional):', localStorage.getItem('vn-gemini-fallback') || '');
  try { localStorage.setItem('vn-gemini-key', k.trim()); if (m !== null) localStorage.setItem('vn-gemini-model', m.trim() || DEFAULT_MODEL); if (fb !== null) localStorage.setItem('vn-gemini-fallback', fb.trim()); if (sm !== null) localStorage.setItem('vn-gemini-search', sm.trim()); if (k2 !== null) localStorage.setItem('vn-gemini-key2', k2.trim()); } catch {}
  msg(k.trim() ? 'Saved.' : 'Key removed.');
};
const SYS = `You are a careful cartographer for an educational world map. Reply with ONLY JSON:
{"features":[{"kind":"state"|"district"|"area"|"river","name":string,"parent":string,"note":string,"conf":"high"|"medium"|"low","coords":[[lon,lat],...]}],"error":string?}
Rules: WGS84 degrees, [lon,lat] order. Polygons: ring without repeating the first point, 10-70 vertices, following the real boundary as closely as you can; the ring must NOT cross itself. Rivers: ordered source to mouth, 15-90 points, following the real course. "parent" = the country (districts: "State, Country"). "note" = one factual sentence under 25 words. "conf" = honest confidence: "high" only if you know the real coordinates well. Use the usual English names. Do not invent places. Maximum 40 features.`;
const CLS = `Classify a map request for an educational atlas. Reply ONLY JSON {"tier":"simple"|"medium"|"hard"|"exists","kind":"area"|"river"|"state"|"district","land":boolean,"natural":boolean,"year":number|null,"polity":string,"subject":string,"reason":string}.
simple = ONLY a river, a lake or another tiny feature. medium = a natural land region (desert, plateau, mountain range, plain, basin) or a political or cultural region at a given time that is easy to describe with modern states or districts. natural = true for geographic features such as a desert, plateau, range or plain. hard = a historical empire, or anything whose borders changed or are disputed. exists = ONLY when the request is exactly a country, a state/province, an Indian district or a major river. Deserts, plateaus, ranges, plains, lakes, historical regions and anything else are NEVER exists. Explain in reason.
year = year the map is for (negative for BCE) or null. polity = 1-3 short comma-separated keywords of the polity's name as on historical maps (e.g. "Maurya"). subject = a clean title including the year. land = true if the shape lies on land only.`;
