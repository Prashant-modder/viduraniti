  const out = (await gem([{ text: `${cmd}\n\nCurrent view (west, south, east, north): ${bb.join(', ')}\nAlready drawn: ${feats.slice(-40).map((f) => f.name).join(', ') || 'nothing'}` }], { system: SYS })).data;
