---
interface NavLink { label: string; href: string }
interface Props {
  title: string;
  eyebrow?: string;
  meta?: string;
  tags?: string[];
  prev?: NavLink | null;
  next?: NavLink | null;
  related?: NavLink[];
  chrome?: boolean; // false = hide related / notice / report (unit pages)
}
const { title, eyebrow, meta, tags = [], prev, next, related = [], chrome = true } = Astro.props;
const reportHref = `/report?page=${encodeURIComponent(Astro.url.pathname)}`;
---

<header class="ph">
  {eyebrow && <div class="ph-eyebrow">{eyebrow}</div>}
  <h1 class="ph-title">{title}</h1>
  {meta && <div class="ph-meta">{meta}</div>}
  {tags.length > 0 && <div class="ph-tags">{tags.map((t) => <span class="ph-tag">{t}</span>)}</div>}
</header>

<div class="ph-tools"><slot name="tools" /></div>

<div class="ph-body"><slot /></div>

{chrome && related.length > 0 && (
  <section class="ph-related">
    <h2 class="ph-related-title">Related chapters</h2>
    <div class="vn-list">
      {related.map((r) => <a class="vn-row" href={r.href}><span>{r.label}</span></a>)}
    </div>
  </section>
)}

{chrome && (
  <footer class="ph-foot">
    <p>Based on NCERT textbooks. All rights in the original content belong to NCERT. ViduraNiti is an independent study aid and is not affiliated with NCERT.</p>
    <a href={reportHref}>Report an error</a>
  </footer>
)}

{(prev || next) && (
  <div class="ph-nav">
    {prev ? <a href={prev.href}>← {prev.label}</a> : <span></span>}
    {next ? <a href={next.href}>{next.label} →</a> : <span></span>}
  </div>
)}

<style>
  .ph { padding-bottom: 24px; border-bottom: 1px solid var(--border); margin-bottom: 32px; }
  .ph-eyebrow { font-family: var(--font-ui); font-size: 12px; color: var(--ink-muted); margin-bottom: 8px; }
  .ph-title { font-size: 26px; font-weight: 600; line-height: 1.25; color: var(--ink); margin-bottom: 8px; }
  .ph-meta { font-family: var(--font-ui); font-size: 13px; color: var(--ink-muted); }
  .ph-tags { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
  .ph-tag { font-family: var(--font-ui); font-size: 11px; font-weight: 500; padding: 3px 10px; border-radius: 999px; background: var(--surface); color: var(--ink-muted); border: 1px solid var(--border); }
  .ph-tools:empty { display: none; }
  .ph-tools { margin-bottom: 20px; }
  .ph-body { font-family: var(--font-body); }
  .ph-related { margin-top: 48px; }
  .ph-related-title { font-family: var(--font-ui); font-size: 16px; font-weight: 600; color: var(--ink); }
  .ph-foot { margin-top: 48px; padding-top: 16px; border-top: 1px solid var(--border); display: flex; gap: 16px; justify-content: space-between; align-items: baseline; flex-wrap: wrap; font-family: var(--font-ui); font-size: 12px; color: var(--ink-faint); line-height: 1.5; }
  .ph-foot p { max-width: 62ch; }
  .ph-foot a { color: var(--saffron); text-decoration: none; font-weight: 500; white-space: nowrap; }
  .ph-nav { display: flex; justify-content: space-between; gap: 12px; margin-top: 32px; padding-bottom: 60px; }
  .ph-nav a { font-family: var(--font-ui); font-size: 14px; font-weight: 500; color: var(--ink); text-decoration: none; padding: 8px 14px; border: 1px solid var(--border); border-radius: 8px; transition: border-color .15s, background .15s; }
  .ph-nav a:hover { border-color: var(--saffron); background: var(--surface); }
  @media (max-width: 768px) { .ph-nav { flex-direction: column; } }
</style>