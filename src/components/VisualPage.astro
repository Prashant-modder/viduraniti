---
// src/components/VisualPage.astro
import Prose from './Prose.astro';
import { renderInline } from '@/lib/md';
import world from '../../public/data/world.json';

/*
  One component for the three data-set pages. `kind` decides what is drawn.
  Every data file exports `meta` ({ title, status?, tags? }) and optionally `intro` (Markdown).

  timeline  export const events = [{ date, end?, title, text?, era? }]
            (shown in the order given, so BCE dates work; `end` makes a range like 1682–1707;
             a heading appears when `era` changes)

  chart     export const chart = one of:
              { type: 'bar', unit?, labels: [...], series: [{ name?, values: [...] }] }
              { type: 'dynasty', rulers: [{ name, years?, note?, children?: [...] }] }   (generation chart)
              { type: 'hub', center: { title, note? }, spokes: [{ title, note? }] }       (council / hub-and-spoke diagram)

  map       export const description = "..."; export const places = [{ name, kind?, note?, lat?, lng? }]
            kind: region | hill-fort | coastal-fort | land-fort | port | city | foreign (grouped like a legend).
            Places with lat/lng are drawn as numbered markers on a simple SVG map (approximate India outline,
            zoomed to fit the places). The numbers match the list below the map. Places without lat/lng
            (regions, foreign powers) appear in the list only.
            Optional: export const features = [{ kind: 'state'|'district'|'area'|'river', name, parent?, note?, coords: [[lon,lat],...] }]
            (made on /map with the "Chapter file" button) are drawn as shapes and rivers with hover cards.
            Optional: export const view = [west, south, east, north] to fix the map frame.
            Backdrop: real country outlines and India's states from /public/data/world.json.
*/
interface Props { data: any; kind: 'map' | 'timeline' | 'chart' }
const { data, kind } = Astro.props;
const intro: string | undefined = data?.intro;

const events: any[] = data?.events ?? [];

const chart = data?.chart ?? {};
const labels: string[] = chart.labels ?? [];
const series: any[] = chart.series ?? [];
const unit: string = chart.unit ?? '';
const max = Math.max(...series.flatMap((s) => (s.values ?? []).map(Number)), 1);
const width = (v: number) => `${Math.max(2, Math.round((Number(v) / max) * 100))}%`;

const rulers: { name: string; years?: string; note?: string; depth: number }[] = [];
const walk = (list: any[], depth: number) => {
  for (const r of list) {
    rulers.push({ name: r.name, years: r.years, note: r.note, depth });
    if (r.children?.length) walk(r.children, depth + 1);
  }
};
walk(chart.rulers ?? [], 0);

const places: any[] = data?.places ?? [];
const KIND_LABEL: Record<string, string> = {
  region: 'Territories', 'hill-fort': 'Hill forts', 'coastal-fort': 'Coastal forts', 'land-fort': 'Land forts',
  port: 'Ports', city: 'Cities', foreign: 'Foreign powers',
};

// Numbered markers for places that have coordinates.
const geo = places.filter((p) => typeof p.lat === 'number' && typeof p.lng === 'number');
const num = new Map<any, number>(geo.map((p, i) => [p, i + 1]));

const groups = new Map<string, any[]>();
for (const p of places) {
  const label = KIND_LABEL[p.kind] ?? 'Places';
  groups.set(label, [...(groups.get(label) ?? []), p]);
}

const FEAT_LABEL: Record<string, string> = { state: 'States', district: 'Districts', area: 'Areas', river: 'Rivers' };
const feats: any[] = (data?.features ?? []).filter((f: any) => Array.isArray(f.coords) && f.coords.length >= 2);
const fgroups = new Map<string, any[]>();
for (const f of feats) fgroups.set(FEAT_LABEL[f.kind] ?? 'Features', [...(fgroups.get(FEAT_LABEL[f.kind] ?? 'Features') ?? []), f]);

// Same projection as /map: 10 units per degree.
const lonX = (l: number) => (l + 180) * 10, latY = (a: number) => (90 - a) * 10;
let vb: number[] = [0, 0, 0, 0], K = 1;
let bgCountries: any[] = [], bgStates: any[] = [];
let pts: { p: any; n: number; x: number; y: number }[] = [];
let fpaths: { f: any; d: string }[] = [];
if (kind === 'map' && (geo.length > 0 || feats.length > 0)) {
  const all: number[][] = [...geo.map((p) => [p.lng, p.lat]), ...feats.flatMap((f) => f.coords)];
  const v = data?.view;
  const PAD = 1.2;
  const w0 = v ? v[0] : Math.min(...all.map((q) => q[0])) - PAD, e0 = v ? v[2] : Math.max(...all.map((q) => q[0])) + PAD;
  const s0 = v ? v[1] : Math.min(...all.map((q) => q[1])) - PAD, n0 = v ? v[3] : Math.max(...all.map((q) => q[1])) + PAD;
  const x0 = lonX(w0), x1 = lonX(e0), y0 = latY(n0), y1 = latY(s0);
  vb = [x0, y0, x1 - x0, y1 - y0];
  K = (x1 - x0) / 600; // keeps markers about 10px whatever the zoom
  const hit = (b: number[]) => b[2] >= x0 && b[0] <= x1 && b[3] >= y0 && b[1] <= y1;
  bgCountries = (world as any).countries.filter((c: any) => c.id !== 'IND' && hit(c.b));
  const ind = (world as any).countries.find((c: any) => c.id === 'IND');
  if (ind && hit(ind.b)) bgStates = (world as any).india;
  pts = geo.map((p) => ({ p, n: num.get(p)!, x: lonX(p.lng), y: latY(p.lat) }));
  fpaths = feats.map((f) => ({
    f,
    d: 'M' + f.coords.map((c: number[]) => `${lonX(c[0]).toFixed(1)} ${latY(c[1]).toFixed(1)}`).join('L') + (f.kind === 'river' ? '' : 'Z'),
  }));
}
---

{intro && <Prose md={intro} />}

{kind === 'timeline' && (
  events.length > 0 ? (
    <ol class="tl">
      {events.map((e, i) => (
        <>
          {e.era && e.era !== events[i - 1]?.era && <li class="tl-era">{e.era}</li>}
          <li class="tl-item">
            <div class="tl-date">{e.end ? `${e.date}–${e.end}` : e.date}</div>
            <div class="tl-body">
              <div class="tl-title" set:html={renderInline(e.title)} />
              {e.text && <div class="tl-text" set:html={renderInline(e.text)} />}
            </div>
          </li>
        </>
      ))}
    </ol>
  ) : <p class="vn-muted">Timeline coming soon.</p>
)}

{kind === 'chart' && chart.type === 'bar' && (
  <div class="ch">
    {labels.map((label, i) => (
      <div class="ch-group">
        <div class="ch-label">{label}</div>
        {series.map((s, k) => (
          <div class="ch-row">
            {series.length > 1 && <span class="ch-sname">{s.name}</span>}
            <span class="ch-bar"><i class={`s${k % 3}`} style={`width:${width(s.values?.[i] ?? 0)}`}></i></span>
            <span class="ch-val">{s.values?.[i]}{unit}</span>
          </div>
        ))}
      </div>
    ))}
  </div>
)}

{kind === 'chart' && chart.type === 'dynasty' && (
  <div class="gn">
    {rulers.map((r) => (
      <div class="gn-node" style={`--d:${r.depth}`}>
        <div class="gn-name">{r.name}{r.years && <small>{r.years}</small>}</div>
        {r.note && <div class="gn-note" set:html={renderInline(r.note)} />}
      </div>
    ))}
  </div>
)}

{kind === 'chart' && chart.type === 'hub' && (
  <div class="hub">
    <div class="hub-center">
      <div class="hub-title">{chart.center?.title}</div>
      {chart.center?.note && <div class="hub-note">{chart.center.note}</div>}
    </div>
    <div class="hub-line"></div>
    <div class="hub-grid">
      {(chart.spokes ?? []).map((sp: any) => (
        <div class="hub-spoke">
          <div class="hub-title">{sp.title}</div>
          {sp.note && <div class="hub-note">{sp.note}</div>}
        </div>
      ))}
    </div>
  </div>
)}

{kind === 'chart' && !['bar', 'dynasty', 'hub'].includes(chart.type) && <p class="vn-muted">Chart coming soon.</p>}

{kind === 'map' && (
  <>
    {data?.description && <p class="mp-desc">{data.description}</p>}

    {(pts.length > 0 || fpaths.length > 0) ? (
      <figure class="mp-fig">
        <svg viewBox={vb.join(' ')} role="img" aria-label={data?.description ?? data?.meta?.title ?? 'Map'} class="mp-svg" style={`--k:${K}`}>
          <rect x={vb[0]} y={vb[1]} width={vb[2]} height={vb[3]} class="mp-sea" />
          {bgCountries.map((c) => <path d={c.d} class="mb" data-name={c.n} data-kind="Country" />)}
          {bgStates.map((st) => <path d={st.d} class="mb st" data-name={st.n} data-kind={`${st.type ?? 'State'} of India`} />)}
          {fpaths.map(({ f }, i) => <path d={fpaths[i].d} class={`mf f-${f.kind}`} data-name={f.name} data-kind={FEAT_LABEL[f.kind]?.replace(/s$/, '') ?? 'Feature'} data-note={[f.parent, f.note].filter(Boolean).join(' · ')} />)}
          {pts.map((m) => (
            <g class={`mk k-${m.p.kind ?? 'place'}`} transform={`translate(${m.x} ${m.y}) scale(${K})`} data-name={m.p.name} data-kind={KIND_LABEL[m.p.kind] ?? 'Place'} data-note={m.p.note ?? ''} data-lat={m.p.lat} data-lng={m.p.lng}>
              <circle r="10" />
              <text y="3.5" text-anchor="middle">{m.n}</text>
            </g>
          ))}
        </svg>
        <div class="mp-tip" hidden></div>
        <figcaption class="mp-cap">Outlines are simplified (Natural Earth). Hover a marker or shape for details. Numbers match the list below. For the full world map, open <a href="/map">/map</a>.</figcaption>
      </figure>
    ) : (
      <div class="mp-soon">
        <p class="mp-soon-title">Map coming soon</p>
      </div>
    )}

    {[...groups].map(([label, items]) => (
      <section class="mp-group">
        <h2 class="mp-group-title">{label}</h2>
        <ul class="mp-places">
          {items.map((p) => (
            <li>
              {num.get(p) && <span class={`mp-n k-${p.kind ?? 'place'}`}>{num.get(p)}</span>}
              <b>{p.name}</b>{p.note && <span class="mp-note"> {p.note}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))}

    {[...fgroups].map(([label, items]) => (
      <section class="mp-group">
        <h2 class="mp-group-title">{label}</h2>
        <ul class="mp-places">
          {items.map((f) => <li><b>{f.name}</b>{(f.parent || f.note) && <span class="mp-note"> {[f.parent, f.note].filter(Boolean).join(' · ')}</span>}</li>)}
        </ul>
      </section>
    ))}
  </>
)}

<script>
  document.querySelectorAll<HTMLElement>('.mp-fig').forEach((fig) => {
    const tip = fig.querySelector<HTMLElement>('.mp-tip')!;
    fig.addEventListener('pointermove', (e) => {
      const g = (e.target as Element).closest<SVGElement>('.mk, .mf, .mb');
      if (!g) { tip.hidden = true; return; }
      const d = g.dataset, r = fig.getBoundingClientRect();
      tip.innerHTML = `<b>${d.name}</b><span>${d.kind}</span>${d.note ? `<p>${d.note}</p>` : ''}${d.lat ? `<small>${Number(d.lat).toFixed(2)}°N, ${Number(d.lng).toFixed(2)}°E</small>` : ''}`;
      tip.hidden = false;
      tip.style.left = Math.min(e.clientX - r.left + 14, r.width - tip.offsetWidth - 4) + 'px';
      tip.style.top = Math.max(e.clientY - r.top - tip.offsetHeight - 10, 4) + 'px';
    });
    fig.addEventListener('pointerleave', () => { tip.hidden = true; });
  });
</script>

<style>
  .tl { list-style: none; max-width: 68ch; margin-top: 8px; padding-left: 4px; border-left: 2px solid var(--border); margin-left: 6px; }
  .tl-era { margin: 28px 0 10px -4px; padding-left: 14px; font-family: var(--font-ui); font-size: 18px; font-weight: 600; color: var(--ink); }
  .tl-item { position: relative; display: grid; grid-template-columns: 110px 1fr; gap: 14px; padding: 10px 0 10px 18px; }
  .tl-item::before { content: ''; position: absolute; left: -9px; top: 17px; width: 10px; height: 10px; border-radius: 50%; background: var(--saffron); }
  .tl-date { font-family: var(--font-ui); font-size: 14px; font-weight: 600; color: var(--saffron); }
  .tl-title { font-family: var(--font-ui); font-size: 16px; font-weight: 600; color: var(--ink); }
  .tl-text { font-size: 15px; line-height: 1.6; color: var(--ink-muted); margin-top: 2px; }

  .ch { max-width: 68ch; display: flex; flex-direction: column; gap: 14px; font-family: var(--font-ui); }
  .ch-label { font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 4px; }
  .ch-row { display: grid; grid-template-columns: auto 1fr auto; gap: 10px; align-items: center; margin-bottom: 3px; }
  .ch-row:not(:has(.ch-sname)) { grid-template-columns: 1fr auto; }
  .ch-sname { font-size: 12px; color: var(--ink-muted); min-width: 70px; }
  .ch-bar { display: block; background: var(--surface-2); border-radius: 4px; height: 14px; overflow: hidden; }
  .ch-bar i { display: block; height: 100%; border-radius: 4px; }
  .ch-bar .s0 { background: var(--saffron); }
  .ch-bar .s1 { background: var(--green); }
  .ch-bar .s2 { background: var(--ink-muted); }
  .ch-val { font-size: 13px; color: var(--ink); min-width: 48px; text-align: right; }

  .gn { max-width: 68ch; display: flex; flex-direction: column; gap: 6px; }
  .gn-node { margin-left: calc(var(--d) * 24px); padding: 8px 14px; border: 1px solid var(--border); border-left: 3px solid var(--saffron); border-radius: 0 8px 8px 0; background: var(--surface); font-family: var(--font-ui); }
  .gn-name { font-size: 15px; font-weight: 600; color: var(--ink); display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
  .gn-name small { font-size: 12px; font-weight: 400; color: var(--ink-muted); }
  .gn-note { font-size: 13px; color: var(--ink-muted); margin-top: 2px; }

  .mp-desc { max-width: 68ch; margin: 8px 0 16px; font-family: var(--font-ui); font-size: 14px; color: var(--ink-muted); }
  .mp-fig { position: relative; max-width: 640px; margin: 0 0 8px; }
  .mp-tip { position: absolute; z-index: 3; width: 220px; padding: 8px 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); box-shadow: 0 4px 12px rgba(0,0,0,.18); pointer-events: none; font-family: var(--font-ui); font-size: 13px; line-height: 1.4; }
  .mp-tip[hidden] { display: none; }
  .mp-tip b { display: block; color: var(--ink); }
  .mp-tip span { color: var(--saffron); font-size: 12px; }
  .mp-tip p { margin: 4px 0 0; color: var(--ink-muted); }
  .mp-tip small { display: block; margin-top: 4px; color: var(--ink-faint); }
  .mk { cursor: pointer; }
  .mk:hover circle { stroke: var(--saffron); stroke-width: 3px; }
  .mp-svg { display: block; width: 100%; height: auto; border: 1px solid var(--border); border-radius: 12px; }
  .mp-sea { fill: var(--surface-2); }
  .mb { fill: var(--bg); stroke: var(--ink-faint); stroke-width: 1px; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .mb.st { fill: var(--surface); stroke: var(--ink-muted); stroke-width: .8px; }
  .mb:hover { fill: var(--saffron-light); }
  .mf { vector-effect: non-scaling-stroke; stroke-linejoin: round; stroke-linecap: round; fill-opacity: .3; stroke-width: 1.6px; }
  .mf:hover { fill-opacity: .55; stroke-width: 2.6px; }
  .mf.f-state { fill: var(--green); stroke: var(--green); }
  .mf.f-district { fill: var(--saffron); stroke: var(--saffron); }
  .mf.f-area { fill: #8A5A9E; stroke: #8A5A9E; }
  .mf.f-river { fill: none; stroke: #1F5FBF; stroke-width: 2.4px; pointer-events: stroke; }
  .mp-cap { margin-top: 6px; font-family: var(--font-ui); font-size: 12px; color: var(--ink-faint); }
  .mk circle { stroke: var(--bg); stroke-width: 2; fill: var(--ink-muted); }
  .mk text { fill: #fff; font-family: var(--font-ui); font-size: 10px; font-weight: 600; pointer-events: none; }
  .mk.k-hill-fort circle { fill: var(--saffron); }
  .mk.k-coastal-fort circle { fill: var(--green); }
  .mk.k-land-fort circle { fill: #8A5A9E; }
  .mk.k-port circle { fill: #1F5FBF; }
  .mk.k-city circle { fill: #D9641E; }

  .mp-soon { padding: 40px 24px; border: 1px dashed var(--border); border-radius: 12px; background: var(--surface); text-align: center; font-family: var(--font-ui); max-width: 68ch; }
  .mp-soon-title { font-size: 16px; font-weight: 600; color: var(--ink); }
  .mp-group { max-width: 68ch; margin-top: 24px; }
  .mp-group-title { font-family: var(--font-ui); font-size: 16px; font-weight: 600; color: var(--ink); }
  .mp-places { list-style: none; margin: 8px 0 0; display: flex; flex-direction: column; gap: 4px; font-size: 15px; line-height: 1.6; }
  .mp-note { color: var(--ink-muted); }
  .mp-n { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; margin-right: 8px; border-radius: 50%; background: var(--ink-muted); color: #fff; font-family: var(--font-ui); font-size: 11px; font-weight: 600; vertical-align: 1px; }
  .mp-n.k-hill-fort { background: var(--saffron); }
  .mp-n.k-coastal-fort { background: var(--green); }
  .mp-n.k-land-fort { background: #8A5A9E; }
  .mp-n.k-port { background: #1F5FBF; }
  .mp-n.k-city { background: #D9641E; }

  .hub { max-width: 68ch; display: flex; flex-direction: column; align-items: center; font-family: var(--font-ui); }
  .hub-center { padding: 14px 28px; border: 2px solid var(--saffron); border-radius: 999px; background: var(--saffron-light); text-align: center; }
  .hub-line { width: 2px; height: 20px; background: var(--border); }
  .hub-grid { width: 100%; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; padding-top: 12px; border-top: 2px solid var(--border); }
  .hub-spoke { padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); text-align: center; }
  .hub-title { font-size: 15px; font-weight: 600; color: var(--ink); }
  .hub-note { font-size: 13px; color: var(--ink-muted); margin-top: 2px; }

  @media (max-width: 480px) { .tl-item { grid-template-columns: 1fr; gap: 2px; } .gn-node { margin-left: calc(var(--d) * 14px); } }
</style>