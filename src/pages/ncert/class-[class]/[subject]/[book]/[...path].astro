---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ChapterSidebar from '@/components/ChapterSidebar.astro';
import SolutionsPage from '@/components/SolutionsPage.astro';
import PageShell from '@/components/PageShell.astro';
import TextbookPage from '@/components/TextbookPage.astro';
import ExamNotesPage from '@/components/ExamNotesPage.astro';
import SummaryPage from '@/components/SummaryPage.astro';
import AnimationPage from '@/components/AnimationPage.astro';
import { loadBook, loadChapter, loadUnit, allRoutes, solutionKeys, prettify, RESERVED } from '@/data/loader';
import { BOOKS, SUBJECT_LABELS } from '@/data/books';

export function getStaticPaths() {
  return allRoutes().map((r) => ({
    params: { class: r.cls, subject: `subject:${r.subject}`, book: r.book, path: r.path },
    props: { kind: r.kind, unitSlug: r.unit, chapterSlug: r.chapter, page: r.page },
  }));
}

const { class: classNum = '', subject = '', book: bookSlug = '' } = Astro.params;
const { kind, unitSlug, chapterSlug, page } = Astro.props as {
  kind: 'unit' | 'chapter' | 'page'; unitSlug: string; chapterSlug: string; page: string;
};

const subKey = subject.replace('subject:', '');
const subLabel = SUBJECT_LABELS[subKey] ?? subKey;
const bookData = BOOKS[classNum]?.[subKey];
const { units } = loadBook(classNum, subKey, bookSlug);

const chapterPath = unitSlug ? `${unitSlug}/${chapterSlug}` : chapterSlug;
const currentUnit = units.find((u) => u.slug === unitSlug);
const unitData = kind === 'unit' ? loadUnit(classNum, subKey, bookSlug, unitSlug) : null;
const empty = { chapter: null as any, pages: {} as Record<string, any>, animations: {} as Record<string, any> };
const { chapter, pages, animations } = kind === 'unit' ? empty : loadChapter(classNum, subKey, bookSlug, chapterPath);

const bookBase = `/ncert/class-${classNum}/${subject}/${bookSlug}`;
const chapterBase = `${bookBase}/${chapterPath}`;

// What kind of page is this?
const isAnim = page.startsWith('animations/');
const animKey = isAnim ? page.slice('animations/'.length) : '';
const pageMod = kind === 'page' ? (isAnim ? animations[animKey] : pages[page]) : null;
const pt: string = kind !== 'page' ? kind : isAnim ? 'animation' : RESERVED.includes(page) ? page : 'solutions';

// Ordered page list for this chapter: textbook, exam-notes, summary, solutions (meta.order), animations
const solKeys = solutionKeys(pages);
const animKeys = Object.keys(animations).sort();
const solTitle = (n: string) => pages[n]?.meta?.title ?? prettify(n);
const chapterPages = [
  ...RESERVED.filter((n) => pages[n]).map((n) => ({
    key: n, label: pages[n]?.meta?.title ?? prettify(n), href: `${chapterBase}/${n}`,
  })),
  ...solKeys.map((n) => ({
    key: n, label: `Solutions · ${solTitle(n)}`, href: `${chapterBase}/solutions/${n}`,
  })),
  ...animKeys.map((n) => ({
    key: `animations/${n}`, label: `Animation · ${animations[n]?.meta?.title ?? prettify(n)}`,
    href: `${chapterBase}/animations/${n}`,
  })),
];

const pageLinks = kind === 'unit' ? [] : chapterPages.map((l) => ({
  label: l.label, href: l.href, active: kind === 'page' && l.key === page,
}));

const title =
  kind === 'unit' ? (unitData?.label ?? currentUnit?.label ?? prettify(unitSlug))
  : kind === 'chapter' ? (chapter?.title ?? chapterSlug)
  : (pageMod?.meta?.title ?? prettify(isAnim ? animKey : page));

// prev / next: pages within the chapter, then neighbouring chapters
const chLabel = (c: any) => `Ch ${c.abs}${c.pos ? '-' + c.pos : ''} · ${c.title}`;
const flat = units.flatMap((u) => u.chapters);
const idx = flat.findIndex((c) => c.href === chapterBase);
const pi = chapterPages.findIndex((l) => l.key === page);
const prevCh = flat[idx - 1] ? { label: chLabel(flat[idx - 1]), href: flat[idx - 1].href } : null;
const nextCh = flat[idx + 1] ? { label: chLabel(flat[idx + 1]), href: flat[idx + 1].href } : null;

const prev = kind === 'unit' ? null
  : kind === 'chapter' ? prevCh
  : pi > 0 ? chapterPages[pi - 1]
  : { label: 'Chapter overview', href: chapterBase };
const next = kind === 'unit' ? null
  : kind === 'chapter' ? (chapterPages[0] ?? nextCh)
  : pi >= 0 && pi < chapterPages.length - 1 ? chapterPages[pi + 1]
  : nextCh;

const unitName = currentUnit?.label ?? prettify(unitSlug);
const eyebrow = kind === 'unit'
  ? (bookData?.title ?? '')
  : `${unitSlug ? unitName + ' · ' : ''}Chapter ${chapter?.abs ?? ''}${kind === 'page' ? ' · ' + (chapter?.title ?? '') : ''}`;
const metaLine = `${bookData?.title} — Class ${classNum} ${subLabel} · NEP 2020`;

const breadcrumb: { label: string; href?: string }[] = [
  { label: 'Home', href: '/' },
  { label: 'NCERT', href: '/ncert' },
  { label: `Class ${classNum}`, href: `/ncert/class-${classNum}` },
  { label: subLabel, href: `/ncert/class-${classNum}/${subject}` },
];
if (kind === 'unit') breadcrumb.push({ label: title });
else {
  if (unitSlug) breadcrumb.push({ label: unitName, href: `${bookBase}/${unitSlug}` });
  if (kind === 'chapter') breadcrumb.push({ label: chapter?.title ?? chapterSlug });
  else {
    breadcrumb.push({ label: chapter?.title ?? chapterSlug, href: chapterBase });
    breadcrumb.push({ label: title });
  }
}
---

<BaseLayout title={`${title} · Class ${classNum}`} breadcrumb={breadcrumb}>
  <div class="chapter-shell">
    <ChapterSidebar
      bookTitle={bookData?.title ?? bookSlug}
      bookSlug={bookSlug}
      bookSub="NEP 2020 Edition"
      classNum={classNum}
      subject={subKey}
      units={units}
      mode={kind === 'unit' ? 'unit' : 'chapter'}
      activeUnit={unitSlug}
      activeChapter={chapterSlug}
      pageLinks={pageLinks}
    />

    {pt === 'solutions' ? (
      <main class="chapter-main flush">
        <SolutionsPage
          title={title}
          eyebrow={eyebrow}
          meta={metaLine}
          subjectTag={subLabel}
          tags={pageMod?.meta?.tags ?? ['Solutions']}
          sections={pageMod?.sections ?? []}
          prev={prev}
          next={next}
        />
      </main>
    ) : (
      <main class="chapter-main">
        <PageShell
          title={title}
          eyebrow={eyebrow}
          meta={kind === 'unit' ? undefined : metaLine}
          tags={pageMod?.meta?.tags ?? []}
          prev={prev}
          next={next}
          related={chapter?.related ?? []}
          chrome={kind !== 'unit'}
        >
          {kind === 'unit' && (
            <div class="vn-list">
              {currentUnit?.chapters.map((c) => (
                <a class="vn-row" href={c.href}>
                  <small>Ch {c.abs}{c.pos ? `-${c.pos}` : ''}</small>
                  <span>{c.title}</span>
                </a>
              ))}
            </div>
          )}

          {kind === 'chapter' && (
            chapterPages.length > 0 ? (
              <div class="vn-list">
                {chapterPages.map((l) => (
                  <a class="vn-row" href={l.href}><span>{l.label}</span></a>
                ))}
              </div>
            ) : <p class="vn-muted">Chapter content coming soon.</p>
          )}

          {pt === 'textbook' && <TextbookPage data={pageMod} />}
          {pt === 'exam-notes' && <ExamNotesPage data={pageMod} />}
          {pt === 'summary' && <SummaryPage data={pageMod} />}
          {pt === 'animation' && <AnimationPage data={pageMod} />}
        </PageShell>
      </main>
    )}
  </div>
</BaseLayout>

<style>
  .chapter-shell { display: flex; margin-top: 52px; min-height: calc(100vh - 52px); }
  .chapter-main { flex: 1; min-width: 0; padding: 32px 40px; }
  .chapter-main.flush { padding: 0; }
  @media (max-width: 768px) {
    .chapter-shell { display: block; }
    .chapter-main { padding: 20px 16px; }
  }
</style>