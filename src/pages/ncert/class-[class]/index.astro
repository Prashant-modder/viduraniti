---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CLASSES, BOOKS, SUBJECT_LABELS } from '@/data/books';
import { loadBook } from '@/data/loader';

export function getStaticPaths() {
  return CLASSES.map((c) => ({ params: { class: String(c) } }));
}

const { class: classNum = '' } = Astro.params;

// One book per subject: link straight to the book's first page.
const subjects = Object.entries(BOOKS[classNum] ?? {}).map(([sub, book]) => {
  const { units } = loadBook(classNum, sub, book.slug);
  const first = units[0];
  const bookBase = `/ncert/class-${classNum}/subject:${sub}/${book.slug}`;
  const href = first
    ? (first.slug ? `${bookBase}/${first.slug}` : first.chapters[0]?.href)
    : undefined;
  return { sub, book, href: href ?? `/ncert/class-${classNum}/subject:${sub}` };
});

const breadcrumb = [
  { label: 'Home', href: '/' },
  { label: 'NCERT', href: '/ncert' },
  { label: `Class ${classNum}` },
];
---

<BaseLayout title={`Class ${classNum}`} breadcrumb={breadcrumb}>
  <div class="vn-page">
    <p class="vn-eyebrow">NCERT</p>
    <h1 class="vn-title">Class {classNum}</h1>
    <div class="vn-list">
      {subjects.map(({ sub, book, href }) => (
        <a class="vn-row" href={href}>
          <span>{SUBJECT_LABELS[sub] ?? sub}</span>
          <span class="vn-book">{book.title}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>